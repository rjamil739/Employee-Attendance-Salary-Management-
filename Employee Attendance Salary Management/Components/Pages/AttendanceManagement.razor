@page "/attendance"
@attribute [StreamRendering]
@attribute [Authorize]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject AuthenticationStateProvider AuthState
@inject AttendanceService Service
@inject EmployeeService EmployeeService
@inject BranchService BranchService
@inject IJSRuntime JS

<PageTitle>Attendance</PageTitle>
<div class="emp-shell"><EmployeeSidebar Active="attendance" IsAdmin="isAdmin"/><main class="emp-main att-main">
 <header class="emp-page-head"><div><span>Workforce operations</span><h1>Attendance management</h1><p>Holidays, shifts, policies, schedules, daily records and approval requests.</p></div><button class="emp-primary" @onclick="OpenCurrentForm">+ Add @AddLabel</button></header>
 @if(message is not null){<div class="emp-notice @(isError?"error":null)">@message</div>}
 <section class="att-stat-grid"><article><i>✓</i><b>@days.Count(x=>x.WorkDate==DateOnly.FromDateTime(DateTime.Today)&&x.Status is "present" or "late")</b><span>Present today</span></article><article><i>◷</i><b>@days.Count(x=>x.WorkDate==DateOnly.FromDateTime(DateTime.Today)&&x.Status=="late")</b><span>Late today</span></article><article><i>▦</i><b>@schedules.Count(x=>x.EffectiveTo is null)</b><span>Active schedules</span></article><article><i>!</i><b>@requests.Count(x=>x.Status=="pending")</b><span>Pending requests</span></article></section>
 <nav class="att-tabs">@foreach(var x in tabs){<button class="@(tab==x.Key?"active":null)" @onclick="()=>SelectTab(x.Key)"><i>@x.Icon</i><span>@x.Label</span></button>}</nav>
 <section class="att-panel">
 @if(loading){<div class="emp-empty">Loading attendance workspace…</div>}
 else if(tab=="calendars"){
  <div class="att-panel-head"><div><h2>Holiday calendars</h2><p>Company-wide or branch-specific calendars and paid holidays.</p></div></div>
  <div class="att-split"><div><h3>Calendars</h3>@foreach(var x in calendars){<article class="att-row"><div><b>@x.Name</b><span>@x.Code · @(x.BranchName??"All branches")</span></div><em class="@(x.IsActive?"on":"off")">@(x.IsActive?"Active":"Inactive")</em><button @onclick="()=>EditCalendar(x)">Edit</button></article>}@if(!calendars.Any()){<div class="emp-empty compact">No calendars added.</div>}</div><div><h3>Holidays</h3>@foreach(var x in holidays){<article class="att-row"><time><b>@x.HolidayDate.Day</b><span>@x.HolidayDate.ToString("MMM")</span></time><div><b>@x.Name</b><span>@x.CalendarName · @(x.IsPaid?"Paid":"Unpaid")</span></div><button @onclick="()=>EditHoliday(x)">Edit</button></article>}@if(!holidays.Any()){<div class="emp-empty compact">No holidays added.</div>}<button class="att-add-secondary" @onclick="NewHoliday">+ Add holiday</button></div></div>
 }
 else if(tab=="shifts"){
  <div class="att-panel-head"><div><h2>Shift management</h2><p>Working hours, breaks and overnight shift rules.</p></div></div><div class="att-card-grid">@foreach(var x in shifts){<article><header><i>◷</i><em class="@(x.IsActive?"on":"off")">@(x.IsActive?"✓ Active":"○ Inactive")</em></header><h3>@x.Name</h3><span>@x.Code</span><dl><div><dt>Timing</dt><dd>@x.StartTime.ToString("hh:mm tt") – @x.EndTime.ToString("hh:mm tt")</dd></div><div><dt>Work</dt><dd>@Minutes(x.ScheduledMinutes)</dd></div><div><dt>Break</dt><dd>@x.BreakMinutes min</dd></div></dl><div class="att-card-actions"><button class="view" @onclick="()=>ViewShift(x)">View</button><button class="edit" @onclick="()=>EditShift(x)">Edit</button><button class="print" @onclick="()=>PrintShift(x)">Print</button></div></article>}@if(!shifts.Any()){<div class="emp-empty">No shifts configured.</div>}</div>
 }
 else if(tab=="policies"){
  <div class="att-panel-head"><div><h2>Attendance policies</h2><p>Grace periods, half days, overtime and weekly-off rules.</p></div></div><div class="att-card-grid">@foreach(var x in policies){<article><header><i>⚙</i><em class="@(x.IsActive?"on":"off")">@(x.IsActive?"✓ Active":"○ Inactive")</em></header><h3>@x.Name</h3><span>@x.Code</span><dl><div><dt>Late grace</dt><dd>@x.LateGraceMinutes min</dd></div><div><dt>Early grace</dt><dd>@x.EarlyOutGraceMinutes min</dd></div><div><dt>Overtime</dt><dd>@x.OvertimeMultiplier.ToString("0.###")×</dd></div><div><dt>Weekly off</dt><dd>@Days(x.WeeklyOffDays)</dd></div></dl><div class="att-card-actions"><button class="view" @onclick="()=>ViewPolicy(x)">View</button><button class="edit" @onclick="()=>EditPolicy(x)">Edit</button><button class="print" @onclick="()=>PrintPolicy(x)">Print</button></div></article>}@if(!policies.Any()){<div class="emp-empty">No policies configured.</div>}</div>
 }
 else if(tab=="schedules"){
  <div class="att-panel-head"><div><h2>Employee schedules</h2><p>Assign effective-dated shifts, policies and holiday calendars.</p></div><input class="att-search" @bind="search" @bind:event="oninput" placeholder="Search employee…"/></div><div class="att-table-wrap"><table><thead><tr><th>Employee</th><th>Shift</th><th>Policy</th><th>Calendar</th><th>Effective period</th><th>Actions</th></tr></thead><tbody>@foreach(var x in schedules.Where(x=>Match(x.EmployeeName,x.EmployeeNo))){<tr><td><b>@x.EmployeeName</b><span>@x.EmployeeNo</span></td><td>@x.ShiftName</td><td>@x.PolicyName</td><td>@(x.CalendarName??"Default")</td><td>@x.EffectiveFrom.ToString("dd MMM yyyy") – @(x.EffectiveTo?.ToString("dd MMM yyyy")??"Present")</td><td><div class="att-table-actions"><button class="view" @onclick="()=>ViewSchedule(x)">View</button><button class="edit" @onclick="()=>EditSchedule(x)">Edit</button><button class="print" @onclick="()=>PrintSchedule(x)">Print</button></div></td></tr>}</tbody></table></div>
 }
 else if(tab=="daily"){
  <div class="att-panel-head"><div><h2>Daily attendance</h2><p>Policy-calculated attendance register; ZKT integration remains excluded.</p></div><div class="att-date-filter"><InputDate @bind-Value="fromDate"/><InputDate @bind-Value="toDate"/><button @onclick="LoadDays">Apply</button><button class="generate" @onclick="GenerateRegister">Generate register</button></div></div><div class="att-table-wrap"><table><thead><tr><th>Date</th><th>Employee</th><th>Assignment</th><th>Clock in/out</th><th>Worked</th><th>Late/Early/OT</th><th>Status</th><th>Source</th></tr></thead><tbody>@foreach(var x in days.Where(x=>x.WorkDate>=fromDate&&x.WorkDate<=toDate)){<tr><td>@x.WorkDate.ToString("dd MMM yyyy")</td><td><b>@x.EmployeeName</b><span>@x.EmployeeNo</span></td><td><b>@x.DepartmentName</b><span>@x.BranchName</span></td><td>@Clock(x.FirstInAt) – @Clock(x.LastOutAt)</td><td>@Minutes(x.WorkedMinutes)</td><td><b>L @x.LateMinutes · E @x.EarlyOutMinutes</b><span>OT @x.OvertimeMinutes min</span></td><td><em class="att-status @x.Status">@Title(x.Status)</em></td><td>@Title(x.EntrySource)</td></tr>}</tbody></table></div>
 }
 else{
  <div class="att-panel-head"><div><h2>Adjustments & overtime</h2><p>Review attendance correction and overtime approval requests.</p></div><select @bind="requestFilter"><option value="">All requests</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option></select></div><div class="att-request-list">@foreach(var x in requests.Where(x=>string.IsNullOrEmpty(requestFilter)||x.Status==requestFilter)){<article><i class="@(x.Kind=="overtime"?"purple":"blue")">@(x.Kind=="overtime"?"◷":"↔")</i><div><b>@x.EmployeeName <small>@Title(x.Kind)</small></b><span>@x.EmployeeNo · @x.BranchName · @x.WorkDate.ToString("dd MMM yyyy")</span><p>@(x.Kind=="overtime"?$"Requested overtime: {x.RequestedMinutes} minutes":$"Requested time: {Clock(x.RequestedFirstInAt)} – {Clock(x.RequestedLastOutAt)}") · @Value(x.Reason)</p></div><em class="att-status @x.Status">@Title(x.Status)</em>@if(x.Status=="pending"){<div class="att-request-actions"><button class="approve" @onclick="()=>Approve(x)">Approve</button><button class="reject" @onclick="()=>Reject(x)">Reject</button></div>}</article>}@if(!requests.Any()){<div class="emp-empty">No requests available.</div>}</div>
 }
 </section>
</main></div>

@if(viewShift is not null){<div class="emp-modal-bg att-shift-view-bg"><section class="att-dialog att-shift-print"><header><div><span>Shift profile</span><h2>@viewShift.Name</h2></div><button class="att-no-print" @onclick="CloseShiftView">×</button></header><div class="att-shift-detail"><div class="att-shift-print-head"><i>◷</i><div><span>Shift code</span><b>@viewShift.Code</b></div><em class="@(viewShift.IsActive?"on":"off")">@(viewShift.IsActive?"✓ Active":"○ Inactive")</em></div><dl><div><dt>Start time</dt><dd>@viewShift.StartTime.ToString("hh:mm tt")</dd></div><div><dt>End time</dt><dd>@viewShift.EndTime.ToString("hh:mm tt")</dd></div><div><dt>Scheduled work</dt><dd>@Minutes(viewShift.ScheduledMinutes)</dd></div><div><dt>Break duration</dt><dd>@viewShift.BreakMinutes minutes</dd></div><div><dt>Crosses midnight</dt><dd>@(viewShift.CrossesMidnight?"Yes":"No")</dd></div><div><dt>Flexible shift</dt><dd>@(viewShift.IsFlexible?"Yes":"No")</dd></div></dl><div class="att-shift-signature"><span>Authorized Signature</span><i></i></div><footer class="att-no-print"><button @onclick="CloseShiftView">Close</button><button class="save" onclick="window.printShiftPanel()">Print shift</button></footer></div></section></div>}

@if(viewPolicy is not null){<div class="emp-modal-bg"><section class="att-dialog att-print-panel"><header><div><span>Attendance policy</span><h2>@viewPolicy.Name</h2></div><button class="att-no-print" @onclick="ClosePreview">×</button></header><div class="att-shift-detail"><div class="att-shift-print-head"><i>⚙</i><div><span>Policy code</span><b>@viewPolicy.Code</b></div><em class="@(viewPolicy.IsActive?"on":"off")">@(viewPolicy.IsActive?"✓ Active":"○ Inactive")</em></div><dl><div><dt>Late grace</dt><dd>@viewPolicy.LateGraceMinutes minutes</dd></div><div><dt>Early-out grace</dt><dd>@viewPolicy.EarlyOutGraceMinutes minutes</dd></div><div><dt>Half-day below</dt><dd>@(viewPolicy.HalfDayBelowMinutes?.ToString()??"—") minutes</dd></div><div><dt>Absent below</dt><dd>@(viewPolicy.AbsentBelowMinutes?.ToString()??"—") minutes</dd></div><div><dt>Overtime after</dt><dd>@viewPolicy.OvertimeAfterMinutes minutes</dd></div><div><dt>OT rounding</dt><dd>@viewPolicy.OvertimeRoundingMinutes minutes</dd></div><div><dt>OT multiplier</dt><dd>@viewPolicy.OvertimeMultiplier.ToString("0.###")×</dd></div><div><dt>Holiday OT</dt><dd>@viewPolicy.HolidayOvertimeMultiplier.ToString("0.###")×</dd></div><div><dt>Weekly off</dt><dd>@Days(viewPolicy.WeeklyOffDays)</dd></div><div><dt>OT approval</dt><dd>@(viewPolicy.RequireOvertimeApproval?"Required":"Not required")</dd></div></dl><div class="att-shift-signature"><span>Authorized Signature</span><i></i></div><footer class="att-no-print"><button @onclick="ClosePreview">Close</button><button class="save" onclick="window.printAttendancePanel()">Print policy</button></footer></div></section></div>}

@if(viewSchedule is not null){<div class="emp-modal-bg"><section class="att-dialog att-print-panel"><header><div><span>Employee schedule</span><h2>@viewSchedule.EmployeeName</h2></div><button class="att-no-print" @onclick="ClosePreview">×</button></header><div class="att-shift-detail"><div class="att-shift-print-head"><i>▦</i><div><span>Employee number</span><b>@viewSchedule.EmployeeNo</b></div><em class="on">✓ Scheduled</em></div><dl><div><dt>Employee</dt><dd>@viewSchedule.EmployeeName</dd></div><div><dt>Shift</dt><dd>@viewSchedule.ShiftName</dd></div><div><dt>Attendance policy</dt><dd>@viewSchedule.PolicyName</dd></div><div><dt>Holiday calendar</dt><dd>@(viewSchedule.CalendarName??"Default / none")</dd></div><div><dt>Effective from</dt><dd>@viewSchedule.EffectiveFrom.ToString("dd MMM yyyy")</dd></div><div><dt>Effective to</dt><dd>@(viewSchedule.EffectiveTo?.ToString("dd MMM yyyy")??"No end date")</dd></div></dl><div class="att-shift-signature"><span>Authorized Signature</span><i></i></div><footer class="att-no-print"><button @onclick="ClosePreview">Close</button><button class="save" onclick="window.printAttendancePanel()">Print schedule</button></footer></div></section></div>}

@if(form is not null){<div class="emp-modal-bg"><section class="att-dialog"><header><div><span>Attendance setup</span><h2>@FormTitle</h2></div><button @onclick="CloseForm">×</button></header><div class="att-dialog-body"><EditForm Model="form" OnValidSubmit="SaveForm" FormName="attendance-form"><DataAnnotationsValidator/>
 @if(form is HolidayCalendarForm c){<div class="emp-form-grid"><label>Calendar code<InputText @bind-Value="c.Code" disabled="true" placeholder="Generated automatically"/></label><label>Calendar name *<InputText @bind-Value="c.Name"/></label><label>Branch<InputSelect @bind-Value="c.BranchId"><option value="">All branches</option>@foreach(var x in branches.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label class="emp-switch"><InputCheckbox @bind-Value="c.IsActive"/><span><b>Active calendar</b></span></label></div>}
 else if(form is HolidayForm h){<div class="emp-form-grid"><label>Calendar *<InputSelect @bind-Value="h.CalendarId"><option value="">Select calendar</option>@foreach(var x in calendars.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Date *<InputDate @bind-Value="h.HolidayDate"/></label><label class="full">Holiday name *<InputText @bind-Value="h.Name"/></label><label class="emp-switch full"><InputCheckbox @bind-Value="h.IsPaid"/><span><b>Paid holiday</b></span></label></div>}
 else if(form is ShiftForm s){<div class="emp-form-grid"><label>Shift code<InputText @bind-Value="s.Code" disabled="true" placeholder="Generated automatically"/></label><label>Shift name *<InputText @bind-Value="s.Name"/></label><label>Start time<input type="time" @bind="s.StartTime"/></label><label>End time<input type="time" @bind="s.EndTime"/></label><label>Break minutes<InputNumber @bind-Value="s.BreakMinutes"/></label><label class="emp-switch"><InputCheckbox @bind-Value="s.CrossesMidnight"/><span><b>Crosses midnight</b></span></label><label class="emp-switch"><InputCheckbox @bind-Value="s.IsFlexible"/><span><b>Flexible shift</b></span></label><label class="emp-switch"><InputCheckbox @bind-Value="s.IsActive"/><span><b>Active shift</b></span></label></div>}
 else if(form is AttendancePolicyForm p){<div class="emp-form-grid"><label>Policy code<InputText @bind-Value="p.Code" disabled="true" placeholder="Generated automatically"/></label><label>Policy name *<InputText @bind-Value="p.Name"/></label><label>Late grace (minutes)<InputNumber @bind-Value="p.LateGraceMinutes"/></label><label>Early-out grace<InputNumber @bind-Value="p.EarlyOutGraceMinutes"/></label><label>Half-day below<InputNumber @bind-Value="p.HalfDayBelowMinutes"/></label><label>Absent below<InputNumber @bind-Value="p.AbsentBelowMinutes"/></label><label>Overtime after<InputNumber @bind-Value="p.OvertimeAfterMinutes"/></label><label>OT rounding<InputNumber @bind-Value="p.OvertimeRoundingMinutes"/></label><label>OT multiplier<InputNumber @bind-Value="p.OvertimeMultiplier"/></label><label>Holiday OT multiplier<InputNumber @bind-Value="p.HolidayOvertimeMultiplier"/></label><label>Weekly off days<InputText @bind-Value="weeklyOffText" placeholder="e.g. 7 or 6,7"/></label><label class="emp-switch"><InputCheckbox @bind-Value="p.RequireOvertimeApproval"/><span><b>Require OT approval</b></span></label><label class="emp-switch full"><InputCheckbox @bind-Value="p.IsActive"/><span><b>Active policy</b></span></label></div>}
 else if(form is EmployeeScheduleForm es){<div class="emp-form-grid"><label>Employee *<InputSelect @bind-Value="es.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Shift *<InputSelect @bind-Value="es.ShiftId"><option value="">Select shift</option>@foreach(var x in shifts.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Policy *<InputSelect @bind-Value="es.PolicyId"><option value="">Select policy</option>@foreach(var x in policies.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Holiday calendar<InputSelect @bind-Value="es.HolidayCalendarId"><option value="">Default / none</option>@foreach(var x in calendars.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Effective from<InputDate @bind-Value="es.EffectiveFrom"/></label><label>Effective to<InputDate @bind-Value="es.EffectiveTo"/></label></div>}
 else if(form is ManualAttendanceForm m){<div class="emp-form-grid"><label>Employee *<InputSelect @bind-Value="m.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Work date<InputDate @bind-Value="m.WorkDate"/></label><label>Clock in<input type="datetime-local" @bind="m.FirstInLocal"/></label><label>Clock out<input type="datetime-local" @bind="m.LastOutLocal"/></label><label>Break minutes<InputNumber @bind-Value="m.BreakMinutes"/></label><div class="att-auto-note">Status, late, early-out and overtime will be calculated automatically from the assigned shift and policy.</div><label class="full">Manual entry reason *<InputText @bind-Value="m.Reason"/></label><label class="full">Notes<InputTextArea @bind-Value="m.Notes"/></label></div>}
 else if(form is AttendanceRequestForm ar){<div class="emp-form-grid"><label>Employee *<InputSelect @bind-Value="ar.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Request type<InputSelect @bind-Value="ar.Kind"><option value="adjustment">Attendance adjustment</option><option value="overtime">Overtime</option></InputSelect></label><label>Work date<InputDate @bind-Value="ar.WorkDate"/></label>@if(ar.Kind=="adjustment"){<label>Requested clock in<input type="datetime-local" @bind="ar.RequestedFirstInLocal"/></label><label>Requested clock out<input type="datetime-local" @bind="ar.RequestedLastOutLocal"/></label>}else{<label>Requested OT minutes<InputNumber @bind-Value="ar.RequestedMinutes"/></label><label>Multiplier<InputNumber @bind-Value="ar.Multiplier"/></label>}<label class="full">Reason *<InputTextArea @bind-Value="ar.Reason"/></label></div>}
 @if(formError is not null){<div class="emp-form-error">@formError</div>}<footer><button type="button" @onclick="CloseForm">Cancel</button><button class="save" disabled="@saving">@(saving?"Saving…":"Save")</button></footer></EditForm></div></section></div>}

@code{
 private readonly (string Key,string Label,string Icon)[] tabs=[("calendars","Holidays","◇"),("shifts","Shifts","◷"),("policies","Policies","⚙"),("schedules","Schedules","▦"),("daily","Daily attendance","✓"),("requests","Requests","!")];
 private IReadOnlyList<HolidayCalendarItem> calendars=[];private IReadOnlyList<HolidayItem> holidays=[];private IReadOnlyList<ShiftItem> shifts=[];private IReadOnlyList<AttendancePolicyItem> policies=[];private IReadOnlyList<EmployeeScheduleItem> schedules=[];private IReadOnlyList<AttendanceDayItem> days=[];private IReadOnlyList<AttendanceRequestItem> requests=[];private IReadOnlyList<EmployeeListItem> employees=[];private IReadOnlyList<BranchListItem> branches=[];private object? form;private ShiftItem? viewShift;private AttendancePolicyItem? viewPolicy;private EmployeeScheduleItem? viewSchedule;private Guid actor;private bool isAdmin,allAccess,loading=true,saving,isError;private string tab="calendars",search="",requestFilter="",weeklyOffText="7";private string? message,formError;private DateOnly fromDate=DateOnly.FromDateTime(DateTime.Today.AddDays(-7)),toDate=DateOnly.FromDateTime(DateTime.Today);
 private string AddLabel=>tab switch{"calendars"=>"calendar","shifts"=>"shift","policies"=>"policy","schedules"=>"schedule","daily"=>"attendance",_=>"request"};private string FormTitle=>form switch{HolidayCalendarForm x when x.Id is not null=>"Edit holiday calendar",HolidayCalendarForm=>"New holiday calendar",HolidayForm x when x.Id is not null=>"Edit holiday",HolidayForm=>"New holiday",ShiftForm x when x.Id is not null=>"Edit shift",ShiftForm=>"New shift",AttendancePolicyForm x when x.Id is not null=>"Edit policy",AttendancePolicyForm=>"New attendance policy",EmployeeScheduleForm x when x.Id is not null=>"Edit employee schedule",EmployeeScheduleForm=>"New employee schedule",ManualAttendanceForm=>"Manual attendance entry",AttendanceRequestForm=>"New attendance request",_=>"Attendance"};
 protected override async Task OnInitializedAsync(){try{var p=(await AuthState.GetAuthenticationStateAsync()).User;actor=Guid.Parse(p.FindFirstValue(ClaimTypes.NameIdentifier)!);isAdmin=p.IsInRole("ADMIN");allAccess=isAdmin||(bool.TryParse(p.FindFirstValue("all_branch_access"),out var a)&&a);var branchTask=BranchService.GetAllAsync();var employeeTask=EmployeeService.GetAllAsync(actor,allAccess);var attendanceTask=Reload();await Task.WhenAll(branchTask,employeeTask,attendanceTask);branches=await branchTask;employees=await employeeTask;}catch(Exception e){message=e.Message;isError=true;}finally{loading=false;}}
 private async Task Reload(){var calendarTask=Service.GetCalendarsAsync();var holidayTask=Service.GetHolidaysAsync();var shiftTask=Service.GetShiftsAsync();var policyTask=Service.GetPoliciesAsync();var scheduleTask=Service.GetSchedulesAsync();var requestTask=Service.GetRequestsAsync();var dayTask=Service.GetDaysAsync(fromDate,toDate);await Task.WhenAll(calendarTask,holidayTask,shiftTask,policyTask,scheduleTask,requestTask,dayTask);calendars=await calendarTask;holidays=await holidayTask;shifts=await shiftTask;policies=await policyTask;schedules=await scheduleTask;requests=await requestTask;days=await dayTask;}
 private async Task LoadDays()=>days=await Service.GetDaysAsync(fromDate,toDate);private async Task GenerateRegister(){try{await Service.GenerateRegisterAsync(fromDate,toDate,actor);await LoadDays();message="Attendance register generated successfully.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}private void SelectTab(string x){tab=x;message=null;form=null;}private void OpenCurrentForm(){form=tab switch{"calendars"=>new HolidayCalendarForm(),"shifts"=>new ShiftForm(),"policies"=>new AttendancePolicyForm(),"schedules"=>new EmployeeScheduleForm(),"daily"=>new ManualAttendanceForm(),"requests"=>new AttendanceRequestForm(),_=>null};formError=null;}private void NewHoliday(){form=new HolidayForm();formError=null;}private void CloseForm(){if(!saving)form=null;}
 private void EditCalendar(HolidayCalendarItem x)=>form=new HolidayCalendarForm{Id=x.Id,BranchId=x.BranchId,Code=x.Code,Name=x.Name,IsActive=x.IsActive};private void EditHoliday(HolidayItem x)=>form=new HolidayForm{Id=x.Id,CalendarId=x.CalendarId,HolidayDate=x.HolidayDate,Name=x.Name,IsPaid=x.IsPaid};private void ViewShift(ShiftItem x)=>viewShift=x;private void CloseShiftView()=>viewShift=null;private async Task PrintShift(ShiftItem x){viewShift=x;await InvokeAsync(StateHasChanged);await Task.Delay(80);await JS.InvokeVoidAsync("printShiftPanel");}private void EditShift(ShiftItem x)=>form=new ShiftForm{Id=x.Id,Code=x.Code,Name=x.Name,StartTime=x.StartTime,EndTime=x.EndTime,BreakMinutes=x.BreakMinutes,CrossesMidnight=x.CrossesMidnight,IsFlexible=x.IsFlexible,IsActive=x.IsActive};private void ViewPolicy(AttendancePolicyItem x)=>viewPolicy=x;private async Task PrintPolicy(AttendancePolicyItem x){viewPolicy=x;await InvokeAsync(StateHasChanged);await Task.Delay(80);await JS.InvokeVoidAsync("printAttendancePanel");}private void ViewSchedule(EmployeeScheduleItem x)=>viewSchedule=x;private async Task PrintSchedule(EmployeeScheduleItem x){viewSchedule=x;await InvokeAsync(StateHasChanged);await Task.Delay(80);await JS.InvokeVoidAsync("printAttendancePanel");}private void ClosePreview(){viewPolicy=null;viewSchedule=null;}private void EditPolicy(AttendancePolicyItem x){form=new AttendancePolicyForm{Id=x.Id,Code=x.Code,Name=x.Name,LateGraceMinutes=x.LateGraceMinutes,EarlyOutGraceMinutes=x.EarlyOutGraceMinutes,HalfDayBelowMinutes=x.HalfDayBelowMinutes,AbsentBelowMinutes=x.AbsentBelowMinutes,OvertimeAfterMinutes=x.OvertimeAfterMinutes,OvertimeRoundingMinutes=x.OvertimeRoundingMinutes,OvertimeMultiplier=x.OvertimeMultiplier,HolidayOvertimeMultiplier=x.HolidayOvertimeMultiplier,WeeklyOffDays=x.WeeklyOffDays,RequireOvertimeApproval=x.RequireOvertimeApproval,IsActive=x.IsActive};weeklyOffText=string.Join(',',x.WeeklyOffDays);}private void EditSchedule(EmployeeScheduleItem x)=>form=new EmployeeScheduleForm{Id=x.Id,EmployeeId=x.EmployeeId,ShiftId=x.ShiftId,PolicyId=x.PolicyId,HolidayCalendarId=x.HolidayCalendarId,EffectiveFrom=x.EffectiveFrom,EffectiveTo=x.EffectiveTo};
 private async Task SaveForm(){saving=true;formError=null;try{switch(form){case HolidayCalendarForm x:await Service.SaveCalendarAsync(x,actor);break;case HolidayForm x:await Service.SaveHolidayAsync(x,actor);break;case ShiftForm x:await Service.SaveShiftAsync(x,actor);break;case AttendancePolicyForm x:x.WeeklyOffDays=weeklyOffText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Select(short.Parse).Distinct().ToArray();if(x.WeeklyOffDays.Any(d=>d<1||d>7))throw new InvalidOperationException("Weekly-off days must be between 1 and 7.");if(x.AbsentBelowMinutes>=x.HalfDayBelowMinutes)throw new InvalidOperationException("Absent threshold must be below half-day threshold.");await Service.SavePolicyAsync(x,actor);break;case EmployeeScheduleForm x:await Service.SaveScheduleAsync(x,actor);break;case ManualAttendanceForm x:await Service.SaveManualDayAsync(x,actor);break;case AttendanceRequestForm x:await Service.SaveRequestAsync(x,actor);break;}await Reload();form=null;message="Attendance record saved successfully.";isError=false;}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.UniqueViolation){formError="A record with the same code or date already exists.";}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.ExclusionViolation){formError="This schedule overlaps an existing employee schedule.";}catch(Exception e){formError=e.Message;}finally{saving=false;}}
 private Task Approve(AttendanceRequestItem x)=>Decide(x,"approved");private Task Reject(AttendanceRequestItem x)=>Decide(x,"rejected");private async Task Decide(AttendanceRequestItem x,string status){try{await Service.DecideRequestAsync(x.Id,x.Kind,status,actor,x.RequestedMinutes);await Reload();message=$"Request {status}.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}
 private bool Match(params string[] values)=>string.IsNullOrWhiteSpace(search)||values.Any(x=>x.Contains(search,StringComparison.OrdinalIgnoreCase));private static string Title(string x)=>System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(x.Replace('_',' '));private static string Value(string? x)=>string.IsNullOrWhiteSpace(x)?"No reason":x;private static string Minutes(int x)=>$"{x/60}h {x%60}m";private static string Clock(DateTimeOffset? x)=>x?.ToOffset(TimeSpan.FromHours(5)).ToString("hh:mm tt")??"—";private static string Days(short[] x)=>string.Join(", ",x.Select(d=>d switch{1=>"Mon",2=>"Tue",3=>"Wed",4=>"Thu",5=>"Fri",6=>"Sat",_=>"Sun"}));
