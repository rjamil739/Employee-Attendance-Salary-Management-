@page "/login/{Role}"
@attribute [AllowAnonymous]
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@inject CompanyProfileService CompanyService

<PageTitle>@RoleTitle Login | @(company?.CompanyName ?? "Employee Portal")</PageTitle>

<main class="login-page @(IsHr ? "hr-theme" : "admin-theme")">
    <a class="back-home" href="/"><span>←</span> Back to home</a>

    <section class="login-shell">
        <div class="login-form-panel">
            <div class="company-brand">
                @if (company?.LogoDataUrl is not null)
                {
                    <img src="@company.LogoDataUrl" alt="@company.CompanyName logo" />
                }
                else
                {
                    <span><svg viewBox="0 0 24 24"><path d="M4 20V7l8-3v16M4 20h16M12 9h8v11" /></svg></span>
                }
                <div><strong>@(company?.CompanyName ?? "Employee Portal")</strong><small>Attendance &amp; Payroll</small></div>
            </div>
            <div class="form-heading">
                <div class="role-icon">
                    @if (IsHr) { <svg viewBox="0 0 24 24"><path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 11l2 2 4-4" /></svg> }
                    else { <svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z" /><path d="m9 12 2 2 4-4" /></svg> }
                </div>
                <div><span class="role-label">@RoleTitle access</span><h2>Sign in to your account</h2></div>
            </div>
            <p class="form-subtitle">Enter your account details below.</p>

            <form method="post" action="/auth/login">
                <AntiforgeryToken />
                <input type="hidden" name="portal" value="@(IsHr ? "hr" : "admin")" />

                <div class="field-group">
                    <label for="user-name">Username</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" /></svg>
                        <input id="user-name" name="userName" class="login-input" autocomplete="username" placeholder="Enter your username" required />
                    </div>
                </div>

                <div class="field-group">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5zM12 15v2" /></svg>
                        <input id="password" name="password" type="password" class="login-input password-input" autocomplete="current-password" placeholder="Enter your password" required />
                        <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" onclick="const input=document.getElementById('password');const showing=input.type==='password';input.type=showing?'text':'password';this.classList.toggle('showing',showing);this.setAttribute('aria-pressed',showing?'true':'false');this.setAttribute('aria-label',showing?'Hide password':'Show password');input.focus();">
                            <svg class="eye-open" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="eye-closed" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A11.8 11.8 0 0 1 12 4c6 0 10 8 10 8a18 18 0 0 1-2.3 3.2M6.6 6.6C3.8 8.5 2 12 2 12s4 8 10 8a9.8 9.8 0 0 0 4.2-.9"/></svg>
                        </button>
                    </div>
                </div>

                <label class="remember-row"><input type="checkbox" name="rememberMe" /> <span>Keep me signed in</span></label>

                @if (Error == "invalid")
                {
                    <div class="login-message error">Username, password or selected portal is incorrect.</div>
                }

                <button class="login-submit" type="submit">Sign in <span>→</span></button>
            </form>

            <p class="security-note"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /></svg> Protected company access</p>
        </div>
    </section>
</main>

@if (Error == "terminated")
{
    <div class="access-popup-backdrop" role="presentation">
        <section class="access-popup" role="alertdialog" aria-modal="true" aria-labelledby="access-popup-title">
            <span class="access-popup-icon">!</span>
            <span class="access-popup-label">Account disabled</span>
            <h2 id="access-popup-title">Your access has been terminated</h2>
            <p>This account is no longer active. Please contact your administrator to restore access.</p>
            <a href="@LoginPath">Okay, go back</a>
        </section>
    </div>
}

@code {
    [Parameter] public string Role { get; set; } = "admin";
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private CompanyProfile? company;
    private bool IsHr => Role.Equals("hr", StringComparison.OrdinalIgnoreCase);
    private string RoleTitle => IsHr ? "HR Manager" : "Administrator";
    private string LoginPath => IsHr ? "/login/hr" : "/login/admin";

    protected override async Task OnInitializedAsync()
    {
        company = await CompanyService.GetAsync();
    }
}
