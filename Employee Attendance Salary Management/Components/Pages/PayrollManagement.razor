@page "/payroll"
@attribute [StreamRendering]
@attribute [Authorize(Roles="ADMIN,HR_MANAGER")]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject AuthenticationStateProvider AuthState
@inject PayrollService Service
@inject EmployeeService EmployeeService
@inject BranchService BranchService
@inject IJSRuntime JS

<PageTitle>Payroll Management</PageTitle>
<div class="emp-shell"><EmployeeSidebar Active="payroll" IsAdmin="isAdmin"/><main class="emp-main payroll-main">
<header class="emp-page-head"><div><span>Compensation operations</span><h1>Payroll management</h1><p>Components, salary assignments, periods, calculations and employee results.</p></div><button class="emp-primary" @onclick="OpenNew">+ @AddLabel</button></header>
@if(message is not null){<div class="emp-notice @(isError?"error":null)">@message</div>}
<section class="payroll-stats"><article class="blue"><i>▤</i><div><b>@periods.Count(x=>x.Status=="open")</b><span>Open periods</span></div></article><article class="purple"><i>◈</i><div><b>@components.Count(x=>x.IsActive)</b><span>Active components</span></div></article><article class="green"><i>✓</i><div><b>@runs.Count(x=>x.Status=="approved")</b><span>Approved runs</span></div></article><article class="orange"><i>Rs</i><div><b>@results.Sum(x=>x.NetPay).ToString("N0")</b><span>Calculated net pay</span></div></article></section>
<nav class="payroll-tabs">@foreach(var x in tabs){<button class="@(tab==x.Key?"active":null)" @onclick="()=>SelectTab(x.Key)">@x.Icon @x.Label</button>}</nav>
<section class="payroll-panel">
@if(loading){<div class="emp-empty">Loading payroll workspace…</div>}
else if(tab=="components"){<header><div><h2>Pay components</h2><p>Earnings, deductions and employer contributions.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search component…"/></header><div class="payroll-card-grid">@foreach(var x in components.Where(x=>Match(x.Name,x.Code,x.ComponentType))){<article><div><i>Rs</i><em class="@(x.IsActive?"on":"off")">@(x.IsActive?"✓ Active":"○ Inactive")</em></div><h3>@x.Name</h3><small>@x.Code · @Title(x.ComponentType)</small><dl><div><dt>Method</dt><dd>@Title(x.CalculationMethod)</dd></div><div><dt>Taxable</dt><dd>@(x.Taxable?"Yes":"No")</dd></div><div><dt>Pensionable</dt><dd>@(x.Pensionable?"Yes":"No")</dd></div><div><dt>Display order</dt><dd>@x.DisplayOrder</dd></div></dl><div class="pay-actions grid"><button class="view" @onclick="()=>View(x)">View</button><button class="edit" @onclick="()=>Edit(x)">Edit</button><button class="print" @onclick="()=>Print(x)">Print</button><button class="@(x.IsActive?"cancel":"enable")" @onclick="()=>Toggle(x)">@(x.IsActive?"Disable":"Enable")</button></div></article>}</div>}
else if(tab=="assignments"){<header><div><h2>Employee components</h2><p>Assign fixed or percentage-based additions and deductions.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search employee…"/></header><div class="payroll-table"><table><thead><tr><th>Employee</th><th>Component</th><th>Type</th><th>Status</th><th>Value</th><th>Effective period</th><th>Actions</th></tr></thead><tbody>@foreach(var x in assignments.Where(x=>Match(x.EmployeeName,x.EmployeeNo,x.ComponentName))){<tr><td><b>@x.EmployeeName</b><span>@x.EmployeeNo</span></td><td>@x.ComponentName</td><td>@Title(x.ComponentType)</td><td><em class="pay-status @(x.ComponentActive?"approved":"cancelled")">@(x.ComponentActive?"Active":"Component inactive")</em></td><td>@(x.FixedAmount is not null?$"Rs {x.FixedAmount:N2}":$"{x.Percentage:0.###}%")</td><td>@x.EffectiveFrom.ToString("dd MMM yyyy") – @(x.EffectiveTo?.ToString("dd MMM yyyy")??"Present")</td><td><div class="pay-actions"><button class="view" @onclick="()=>View(x)">View</button><button class="edit" @onclick="()=>Edit(x)">Edit</button><button class="print" @onclick="()=>Print(x)">Print</button></div></td></tr>}</tbody></table></div>}
else if(tab=="periods"){<header><div><h2>Payroll periods</h2><p>Define non-overlapping salary processing periods.</p></div></header><div class="payroll-card-grid">@foreach(var x in periods){<article><div><i>▦</i><em class="@x.Status">@Title(x.Status)</em></div><h3>@x.PeriodCode</h3><small>Payment: @x.PaymentDate.ToString("dd MMM yyyy")</small><dl><div><dt>Start</dt><dd>@x.StartDate.ToString("dd MMM yyyy")</dd></div><div><dt>End</dt><dd>@x.EndDate.ToString("dd MMM yyyy")</dd></div></dl><div class="pay-actions grid"><button class="view" @onclick="()=>View(x)">View</button>@if(x.Status=="open"){<button class="edit" @onclick="()=>Edit(x)">Edit</button>}<button class="print" @onclick="()=>Print(x)">Print</button>@if(x.Status=="open"){<button class="close" @onclick="()=>ClosePeriod(x)">Close</button>}</div></article>}</div>}
else if(tab=="runs"){<header><div><h2>Payroll runs</h2><p>Create, calculate, review, approve and post payroll.</p></div></header><div class="payroll-table"><table><thead><tr><th>Period</th><th>Branch</th><th>Run</th><th>Status</th><th>Completed</th><th>Actions</th></tr></thead><tbody>@foreach(var x in runs){<tr><td><b>@x.PeriodCode</b></td><td>@(x.BranchName??"All branches")</td><td>#@x.RunNo</td><td><em class="pay-status @x.Status">@Title(x.Status)</em></td><td>@(x.CompletedAt?.ToString("dd MMM yyyy HH:mm")??"—")</td><td><div class="pay-actions"><button class="view" @onclick="()=>OpenResults(x)">Results</button>@if(x.Status is "draft" or "calculated"){<button class="calculate" @onclick="()=>Calculate(x)">Calculate</button>}@if(x.Status=="calculated"){<button class="approve" @onclick="()=>ApproveRun(x)">Approve</button>}@if(x.Status=="approved"){<button class="post" @onclick="()=>PostRun(x)">Post</button>}@if(x.Status is "draft" or "calculated"){<button class="cancel" @onclick="()=>CancelRun(x)">Cancel</button>}</div></td></tr>}</tbody></table></div>}
else{<header><div><h2>Employee payroll results</h2><p>Calculated gross earnings, deductions and net salary.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search employee…"/></header><div class="payroll-table"><table><thead><tr><th>Employee</th><th>Branch / Department</th><th>Base</th><th>Payable days</th><th>Gross</th><th>Deductions</th><th>Net pay</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var x in results.Where(x=>Match(x.EmployeeName,x.EmployeeNo,x.BranchName))){<tr><td><b>@x.EmployeeName</b><span>@x.EmployeeNo</span></td><td><b>@x.BranchName</b><span>@x.DepartmentName</span></td><td>Rs @x.BaseSalary.ToString("N2")</td><td>@x.PayableDays.ToString("0.##")</td><td>Rs @x.GrossEarnings.ToString("N2")</td><td>Rs @x.TotalDeductions.ToString("N2")</td><td><strong>Rs @x.NetPay.ToString("N2")</strong></td><td><em class="pay-status @x.Status">@Title(x.Status)</em></td><td><div class="pay-actions"><button class="view" @onclick="()=>View(x)">View</button><button class="print" @onclick="()=>Print(x)">Print</button>@if(x.Status=="calculated"){<button class="hold" @onclick="()=>Hold(x)">Hold</button>}@if(x.Status=="held"){<button class="enable" @onclick="()=>Release(x)">Release</button>}</div></td></tr>}</tbody></table></div>}
</section></main></div>

@if(form is not null){<div class="emp-modal-bg"><section class="pay-dialog"><header><div><span>Payroll management</span><h2>@FormTitle</h2></div><button @onclick="Close">×</button></header><EditForm Model="form" OnValidSubmit="Save" FormName="payroll-form"><DataAnnotationsValidator/><div class="pay-form-grid">
@if(form is PayComponentForm c){<label>Code<InputText @bind-Value="c.Code" disabled placeholder="Generated automatically"/></label><label>Name *<InputText @bind-Value="c.Name"/></label><label>Component type<InputSelect @bind-Value="c.ComponentType"><option value="earning">Earning</option><option value="deduction">Deduction</option><option value="employer_contribution">Employer contribution</option></InputSelect></label><label>Calculation method<InputSelect @bind-Value="c.CalculationMethod"><option value="fixed">Fixed</option><option value="percentage">Percentage</option><option value="attendance">Attendance</option><option value="overtime">Overtime</option><option value="formula">Formula</option></InputSelect></label><label>Display order<InputNumber @bind-Value="c.DisplayOrder"/></label><label class="pay-check"><InputCheckbox @bind-Value="c.Taxable"/> Taxable</label><label class="pay-check"><InputCheckbox @bind-Value="c.Pensionable"/> Pensionable</label><label class="pay-check"><InputCheckbox @bind-Value="c.IsActive"/> Active component</label>}
else if(form is EmployeeComponentForm a){<label>Employee *<InputSelect @bind-Value="a.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Component *<InputSelect @bind-Value="a.ComponentId"><option value="">Select component</option>@foreach(var x in components.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name · @Title(x.ComponentType)</option>}</InputSelect></label><label>Fixed amount<InputNumber @bind-Value="a.FixedAmount"/></label><label>Percentage of base<InputNumber @bind-Value="a.Percentage"/></label><label>Effective from<InputDate @bind-Value="a.EffectiveFrom"/></label><label>Effective to<InputDate @bind-Value="a.EffectiveTo"/></label><p class="pay-hint">Enter either fixed amount or percentage, not both.</p>}
else if(form is PayrollPeriodForm p){<label>Period code<InputText @bind-Value="p.PeriodCode" disabled placeholder="Generated automatically"/></label><label>Start date<InputDate @bind-Value="p.StartDate"/></label><label>End date<InputDate @bind-Value="p.EndDate"/></label><label>Payment date<InputDate @bind-Value="p.PaymentDate"/></label>}
else if(form is PayrollRunForm r){<label>Payroll period *<InputSelect @bind-Value="r.PeriodId"><option value="">Select open period</option>@foreach(var x in periods.Where(x=>x.Status=="open")){<option value="@x.Id">@x.PeriodCode</option>}</InputSelect></label><label>Branch<InputSelect @bind-Value="r.BranchId"><option value="">All branches</option>@foreach(var x in branches.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label class="full">Notes<InputTextArea @bind-Value="r.Notes"/></label>}
</div>@if(formError is not null){<div class="emp-form-error">@formError</div>}<footer><button type="button" @onclick="Close">Cancel</button><button class="save" disabled="@saving">@(saving?"Saving…":"Save")</button></footer></EditForm></section></div>}

@if(viewTitle is not null){<div class="emp-modal-bg"><section class="pay-dialog payroll-print-panel"><header><div><span>Payroll management</span><h2>@viewTitle</h2></div><button class="pay-no-print" @onclick="CloseView">×</button></header><div class="pay-view"><div class="pay-view-banner"><i>Rs</i><div><span>Record details</span><b>@viewSubtitle</b></div></div><dl>@foreach(var row in viewRows){<div><dt>@row.Label</dt><dd>@row.Value</dd></div>}</dl><div class="pay-signature"><span>Authorized Signature</span><i></i></div><footer class="pay-no-print"><button @onclick="CloseView">Close</button><button class="save" onclick="window.printAttendancePanel('.payroll-print-panel')">Print</button></footer></div></section></div>}

@code{
 private readonly (string Key,string Label,string Icon)[] tabs=[("components","Components","◈"),("assignments","Employee setup","♙"),("periods","Periods","▦"),("runs","Payroll runs","▶"),("results","Results","Rs")];private IReadOnlyList<PayComponentItem> components=[];private IReadOnlyList<EmployeeComponentItem> assignments=[];private IReadOnlyList<PayrollPeriodItem> periods=[];private IReadOnlyList<PayrollRunItem> runs=[];private IReadOnlyList<PayrollResultItem> results=[];private IReadOnlyList<EmployeeListItem> employees=[];private IReadOnlyList<BranchListItem> branches=[];private object? form;private Guid actor;private bool isAdmin,loading=true,saving,isError;private string tab="components",search="";private string? message,formError,viewTitle,viewSubtitle;private List<(string Label,string Value)> viewRows=[];
 private string AddLabel=>tab switch{"components"=>"Add component","assignments"=>"Assign component","periods"=>"Add period","runs"=>"Create payroll run",_=>"Create payroll run"};private string FormTitle=>form switch{PayComponentForm x when x.Id is not null=>"Edit pay component",PayComponentForm=>"Create pay component",EmployeeComponentForm x when x.Id is not null=>"Edit employee component",EmployeeComponentForm=>"Assign employee component",PayrollPeriodForm x when x.Id is not null=>"Edit payroll period",PayrollPeriodForm=>"Create payroll period",PayrollRunForm=>"Create payroll run",_=>"Payroll"};
 protected override async Task OnInitializedAsync(){try{var p=(await AuthState.GetAuthenticationStateAsync()).User;actor=Guid.Parse(p.FindFirstValue(ClaimTypes.NameIdentifier)!);isAdmin=p.IsInRole("ADMIN");var emp=EmployeeService.GetAllAsync(actor,isAdmin||(bool.TryParse(p.FindFirstValue("all_branch_access"),out var a)&&a));var br=BranchService.GetAllAsync();await Task.WhenAll(emp,br,Reload());employees=await emp;branches=await br;}catch(Exception e){message=e.Message;isError=true;}finally{loading=false;}}
 private async Task Reload(){var c=Service.GetComponentsAsync();var a=Service.GetEmployeeComponentsAsync();var p=Service.GetPeriodsAsync();var r=Service.GetRunsAsync();var x=Service.GetResultsAsync();await Task.WhenAll(c,a,p,r,x);components=await c;assignments=await a;periods=await p;runs=await r;results=await x;}
 private void SelectTab(string x){tab=x;search="";form=null;}private void OpenNew(){form=tab switch{"components"=>new PayComponentForm(),"assignments"=>new EmployeeComponentForm(),"periods"=>new PayrollPeriodForm(),_=>new PayrollRunForm()};formError=null;}private void Close(){if(!saving)form=null;}private void Edit(PayComponentItem x)=>form=new PayComponentForm{Id=x.Id,Code=x.Code,Name=x.Name,ComponentType=x.ComponentType,CalculationMethod=x.CalculationMethod,Taxable=x.Taxable,Pensionable=x.Pensionable,DisplayOrder=x.DisplayOrder,IsActive=x.IsActive};private void Edit(EmployeeComponentItem x)=>form=new EmployeeComponentForm{Id=x.Id,EmployeeId=x.EmployeeId,ComponentId=x.ComponentId,FixedAmount=x.FixedAmount,Percentage=x.Percentage,EffectiveFrom=x.EffectiveFrom,EffectiveTo=x.EffectiveTo};private void Edit(PayrollPeriodItem x)=>form=new PayrollPeriodForm{Id=x.Id,PeriodCode=x.PeriodCode,StartDate=x.StartDate,EndDate=x.EndDate,PaymentDate=x.PaymentDate};
 private void View(PayComponentItem x){viewTitle=x.Name;viewSubtitle=x.Code;viewRows=[("Status",x.IsActive?"Active":"Inactive"),("Type",Title(x.ComponentType)),("Calculation",Title(x.CalculationMethod)),("Taxable",x.Taxable?"Yes":"No"),("Pensionable",x.Pensionable?"Yes":"No"),("Display order",x.DisplayOrder.ToString())];}private void View(EmployeeComponentItem x){viewTitle=x.EmployeeName;viewSubtitle=x.EmployeeNo;viewRows=[("Component",x.ComponentName),("Component status",x.ComponentActive?"Active":"Inactive"),("Type",Title(x.ComponentType)),("Value",x.FixedAmount is not null?$"Rs {x.FixedAmount:N2}":$"{x.Percentage:0.###}%"),("Effective from",x.EffectiveFrom.ToString("dd MMM yyyy")),("Effective to",x.EffectiveTo?.ToString("dd MMM yyyy")??"Ongoing")];}private void View(PayrollPeriodItem x){viewTitle=x.PeriodCode;viewSubtitle="Payroll period";viewRows=[("Status",Title(x.Status)),("Start date",x.StartDate.ToString("dd MMM yyyy")),("End date",x.EndDate.ToString("dd MMM yyyy")),("Payment date",x.PaymentDate.ToString("dd MMM yyyy"))];}private void View(PayrollResultItem x){viewTitle="Salary slip";viewSubtitle=x.EmployeeName;viewRows=[("Employee number",x.EmployeeNo),("Branch",x.BranchName),("Department",x.DepartmentName),("Base salary",$"Rs {x.BaseSalary:N2}"),("Payable days",x.PayableDays.ToString("0.##")),("Worked minutes",x.WorkedMinutes.ToString()),("Overtime minutes",x.OvertimeMinutes.ToString()),("Unpaid leave",$"{x.UnpaidLeaveDays:0.##} days"),("Gross earnings",$"Rs {x.GrossEarnings:N2}"),("Deductions",$"Rs {x.TotalDeductions:N2}"),("Employer contributions",$"Rs {x.EmployerContributions:N2}"),("Net pay",$"Rs {x.NetPay:N2}"),("Status",Title(x.Status))];}private async Task Print(object x){switch(x){case PayComponentItem a:View(a);break;case EmployeeComponentItem a:View(a);break;case PayrollPeriodItem a:View(a);break;case PayrollResultItem a:View(a);break;}await InvokeAsync(StateHasChanged);await Task.Delay(80);await JS.InvokeVoidAsync("printAttendancePanel",".payroll-print-panel");}private void CloseView()=>viewTitle=null;private async Task Toggle(PayComponentItem x){try{await Service.SetComponentActiveAsync(x.Id,!x.IsActive,actor);await Reload();message=$"Component {(x.IsActive?"disabled":"enabled")}.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}
 private async Task Save(){saving=true;formError=null;try{switch(form){case PayComponentForm x:await Service.SaveComponentAsync(x,actor);break;case EmployeeComponentForm x:await Service.SaveEmployeeComponentAsync(x,actor);break;case PayrollPeriodForm x:await Service.SavePeriodAsync(x,actor);break;case PayrollRunForm x:await Service.CreateRunAsync(x,actor);break;}await Reload();form=null;message="Payroll record saved successfully.";isError=false;}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.ExclusionViolation){formError="The selected effective dates overlap an existing record.";}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.UniqueViolation){formError="A duplicate payroll record already exists.";}catch(Exception e){formError=e.Message;}finally{saving=false;}}
 private async Task Calculate(PayrollRunItem x){try{await Service.CalculateAsync(x.Id,actor);await Reload();tab="results";message="Payroll calculated successfully.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}private Task ApproveRun(PayrollRunItem x)=>SetStatus(x,"approved");private Task CancelRun(PayrollRunItem x)=>SetStatus(x,"cancelled");private async Task SetStatus(PayrollRunItem x,string status){try{await Service.SetRunStatusAsync(x.Id,status,actor);await Reload();message=$"Payroll run {status}.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}private async Task OpenResults(PayrollRunItem x){results=await Service.GetResultsAsync(x.Id);tab="results";}private bool Match(params string[] x)=>string.IsNullOrWhiteSpace(search)||x.Any(v=>v.Contains(search,StringComparison.OrdinalIgnoreCase));private static string Title(string x)=>System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(x.Replace('_',' '));
 private async Task Hold(PayrollResultItem x)=>await HoldResult(x,true);private async Task Release(PayrollResultItem x)=>await HoldResult(x,false);private async Task HoldResult(PayrollResultItem x,bool hold){try{await Service.SetResultHoldAsync(x.Id,hold,actor);results=await Service.GetResultsAsync(x.RunId);message=$"Employee salary {(hold?"held":"released")}.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}private async Task ClosePeriod(PayrollPeriodItem x){try{await Service.ClosePeriodAsync(x.Id,actor);await Reload();message="Payroll period closed and locked.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}private async Task PostRun(PayrollRunItem x){try{await Service.PostRunAsync(x.Id,actor);await Reload();message="Payroll posted to Finance journal.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}
}
