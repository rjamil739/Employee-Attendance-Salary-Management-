@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject CompanyProfileService CompanyService

<PageTitle>@(company?.CompanyName ?? "HR Orbit") | Welcome</PageTitle>

<main class="home-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Home">
            @if (company?.LogoDataUrl is not null)
            {
                <img class="brand-logo" src="@company.LogoDataUrl" alt="@company.CompanyName logo" />
            }
            else
            {
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32"><path d="M8 7.5h16a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-11a3 3 0 0 1 3-3Z"/><path d="M12 7.5v-2h8v2M5 14h22M13 18h6"/></svg>
                </span>
            }
            <span>
                <strong>@(company?.CompanyName ?? "HR Orbit")</strong>
                <small>People & Payroll</small>
            </span>
        </a>

        <nav class="role-tabs" aria-label="Quick access">
            <button class="role-tab active" type="button" @onclick='() => SelectRole("admin")'>
                <span class="tab-dot"></span> Admin
            </button>
            <button class="role-tab" type="button" @onclick='() => SelectRole("hr")'>
                <span class="tab-dot"></span> HR Manager
            </button>
            <button class="role-tab company-tab" type="button" disabled="@(company is not null)" @onclick="OpenCompanyPanel">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V6l8-3v18M4 21h16M12 9h8v12M8 9v.01M8 13v.01M8 17v.01M16 13v.01M16 17v.01"/></svg>
                Company setup
                @if (company is not null)
                {
                    <span class="setup-done" title="Company profile completed">✓</span>
                }
            </button>
        </nav>
    </header>

    @if (isLoading)
    {
        <section class="loading-state" aria-live="polite">
            <span class="loader"></span>
            <p>Preparing your workspace…</p>
        </section>
    }
    else if (showCompanyPanel && company is null)
    {
        <section class="company-setup-wrap">
            <button class="back-button" type="button" @onclick="CloseCompanyPanel"><span>←</span> Back to welcome</button>
            <div class="company-panel">
                <div class="setup-copy">
                    <span class="eyebrow"><span></span> One-time setup</span>
                    <h1>Let’s add your company.</h1>
                    <p>This identity will appear across your HR, attendance and payroll workspace.</p>
                    <div class="setup-points">
                        <div><span>01</span><p><strong>Company identity</strong><small>Add the official company name.</small></p></div>
                        <div><span>02</span><p><strong>Brand logo</strong><small>Upload a clear PNG, JPG, WEBP or SVG.</small></p></div>
                        <div><span>03</span><p><strong>Ready to work</strong><small>Your home screen updates instantly.</small></p></div>
                    </div>
                </div>

                <EditForm Model="companyForm" OnValidSubmit="SaveCompanyAsync" class="company-form" FormName="company-setup">
                    <DataAnnotationsValidator />
                    <div class="form-heading">
                        <span class="form-icon"><svg viewBox="0 0 24 24"><path d="M4 21V6l8-3v18M4 21h16M12 9h8v12M8 9v.01M8 13v.01M8 17v.01M16 13v.01M16 17v.01"/></svg></span>
                        <div><h2>Company profile</h2><p>Complete the details below</p></div>
                    </div>

                    <label class="field-label" for="company-name">Company name</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V5h10v16M15 9h4v12M9 9v.01M9 13v.01M9 17v.01"/></svg>
                        <InputText id="company-name" class="text-input" @bind-Value="companyForm.CompanyName" placeholder="e.g. Northstar Textiles" />
                    </div>
                    <ValidationMessage For="() => companyForm.CompanyName" />

                    <label class="field-label">Company logo <span>Optional</span></label>
                    <label class="logo-drop @(logoPreview is not null ? "has-logo" : "")">
                        <InputFile OnChange="HandleLogoAsync" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                        @if (logoPreview is not null)
                        {
                            <img src="@logoPreview" alt="Selected company logo" />
                            <div><strong>@logoFileName</strong><small>Click to choose a different logo</small></div>
                        }
                        else
                        {
                            <span class="upload-icon"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M5 14v5h14v-5"/></svg></span>
                            <div><strong>Drop your logo here or <u>browse</u></strong><small>PNG, JPG, WEBP or SVG · Maximum 2 MB</small></div>
                        }
                    </label>
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="form-error" role="alert">@formError</div>
                    }

                    <button class="save-company" type="submit" disabled="@isSaving">
                        @if (isSaving) { <span class="button-loader"></span> }
                        <span>@(isSaving ? "Saving company…" : "Save company & continue")</span>
                        @if (!isSaving) { <span>→</span> }
                    </button>
                    <p class="secure-note"><svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z"/></svg> Your company profile is stored securely.</p>
                </EditForm>
            </div>
        </section>
    }
    else
    {
        <section class="hero">
            <div class="hero-copy">
                <span class="eyebrow"><span></span> Smart workforce management</span>
                <h1>Welcome to<br /><em>@(company?.CompanyName ?? "your HR workspace")</em></h1>
                <p>Attendance, people and payroll—brought together in one calm, reliable workspace.</p>
                <div class="hero-stats">
                    <div><strong>One</strong><span>connected platform</span></div><i></i>
                    <div><strong>24/7</strong><span>secure access</span></div><i></i>
                    <div><strong>100%</strong><span>payroll clarity</span></div>
                </div>
            </div>
            <div class="hero-visual" aria-hidden="true">
                <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
                <div class="glass-card attendance-card">
                    <span class="mini-icon mint"><svg viewBox="0 0 24 24"><path d="M8 3v3M16 3v3M4 9h16M5 5h14v16H5zM8 13h3v3H8z"/></svg></span>
                    <div><small>Today’s attendance</small><strong>92.4%</strong></div><span class="trend">↗ 4.2%</span>
                </div>
                <div class="glass-card payroll-card">
                    <span class="mini-icon blue"><svg viewBox="0 0 24 24"><path d="M4 7h16v12H4zM16 11h4M7 4h10v3"/></svg></span>
                    <div><small>Payroll status</small><strong>Ready</strong></div><span class="status-pill"><i></i> On track</span>
                </div>
                <div class="people-stack"><span>AJ</span><span>SK</span><span>NM</span><span>+24</span></div>
                <div class="visual-center">
                    @if (company?.LogoDataUrl is not null)
                    {
                        <img src="@company.LogoDataUrl" alt="" />
                    }
                    else
                    {
                        <svg viewBox="0 0 48 48"><path d="M12 11h24a5 5 0 0 1 5 5v17a5 5 0 0 1-5 5H12a5 5 0 0 1-5-5V16a5 5 0 0 1 5-5Z"/><path d="M18 11V7h12v4M7 22h34M19 28h10"/></svg>
                    }
                </div>
            </div>
        </section>

        <section class="login-section" id="login-access">
            <div class="section-heading">
                <div><span class="eyebrow"><span></span> Secure sign in</span><h2>Choose your workspace</h2></div>
                <p>Select your role to continue to the right dashboard.</p>
            </div>
            <div class="login-grid">
                <article class="login-card admin-card @(highlightedRole == "admin" ? "highlighted" : "")">
                    <div class="card-topline"><span>Company access</span><span class="access-badge">Full access</span></div>
                    <div class="login-icon admin-icon"><svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z"/><path d="m9 12 2 2 4-4"/></svg></div>
                    <h3>Administrator</h3>
                    <p>Manage company settings, teams, permissions and complete payroll operations.</p>
                    <ul><li><span>✓</span> Company-wide controls</li><li><span>✓</span> Payroll & finance access</li></ul>
                    <button type="button" class="login-button admin-button">Continue as Admin <span>→</span></button>
                </article>

                <article class="login-card hr-card @(highlightedRole == "hr" ? "highlighted" : "")">
                    <div class="card-topline"><span>Branch access</span><span class="access-badge">HR workspace</span></div>
                    <div class="login-icon hr-icon"><svg viewBox="0 0 24 24"><path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 11l2 2 4-4"/></svg></div>
                    <h3>HR Manager</h3>
                    <p>Manage employees, attendance, leave requests and branch payroll workflows.</p>
                    <ul><li><span>✓</span> Employee & attendance tools</li><li><span>✓</span> Branch-level operations</li></ul>
                    <button type="button" class="login-button hr-button">Continue as HR Manager <span>→</span></button>
                </article>
            </div>
        </section>
    }

    <footer>
        <span>© @DateTime.Now.Year @(company?.CompanyName ?? "HR Orbit")</span>
        <span class="footer-status"><i></i> Systems operational</span>
        <span>HR · Attendance · Payroll</span>
    </footer>
</main>

@code {
    private const long MaxLogoSize = 2 * 1024 * 1024;
    private CompanyProfile? company;
    private readonly CompanyFormModel companyForm = new();
    private byte[]? logoBytes;
    private string? logoPreview;
    private string? logoFileName;
    private string? formError;
    private string? highlightedRole;
    private bool isLoading = true;
    private bool isSaving;
    private bool showCompanyPanel;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            company = await CompanyService.GetAsync();
            showCompanyPanel = company is null;
        }
        catch (Exception)
        {
            formError = "The company profile could not be loaded. Please confirm the database connection.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCompanyPanel()
    {
        if (company is null) showCompanyPanel = true;
    }

    private void CloseCompanyPanel() => showCompanyPanel = false;

    private void SelectRole(string role)
    {
        showCompanyPanel = false;
        highlightedRole = role;
    }

    private async Task HandleLogoAsync(InputFileChangeEventArgs args)
    {
        formError = null;
        var file = args.File;
        string[] allowedTypes = ["image/png", "image/jpeg", "image/webp", "image/svg+xml"];

        if (!allowedTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            formError = "Please choose a PNG, JPG, WEBP or SVG image.";
            return;
        }

        if (file.Size > MaxLogoSize)
        {
            formError = "The logo must be smaller than 2 MB.";
            return;
        }

        await using var stream = file.OpenReadStream(MaxLogoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        logoBytes = memoryStream.ToArray();
        logoFileName = file.Name;
        logoPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(logoBytes)}";
    }

    private async Task SaveCompanyAsync()
    {
        if (isSaving || company is not null) return;

        isSaving = true;
        formError = null;
        try
        {
            company = await CompanyService.CreateAsync(companyForm.CompanyName, logoBytes);
            showCompanyPanel = false;
        }
        catch (PostgresException exception) when (exception.SqlState == "23505")
        {
            company = await CompanyService.GetAsync();
            showCompanyPanel = false;
        }
        catch (Exception)
        {
            formError = "Company profile could not be saved. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class CompanyFormModel
    {
        [Required(ErrorMessage = "Company name is required.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "Enter a company name between 2 and 150 characters.")]
        public string CompanyName { get; set; } = string.Empty;
    }
}
