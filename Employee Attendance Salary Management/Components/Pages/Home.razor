@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject CompanyProfileService CompanyService

<PageTitle>@(company?.CompanyName ?? "Company setup")</PageTitle>

<main class="welcome-page">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Home">
            @if (company?.LogoDataUrl is not null)
            {
                <img src="@company.LogoDataUrl" alt="@company.CompanyName logo" />
            }
            else
            {
                <span class="brand-placeholder">
                    <svg viewBox="0 0 24 24"><path d="M4 20V7l8-3v16M4 20h16M12 9h8v11M8 9v.01M8 13v.01M8 17v.01M16 13v.01M16 17v.01" /></svg>
                </span>
            }
            <span class="brand-copy">
                <strong>@(company?.CompanyName ?? "Company setup")</strong>
                <small>Attendance & Payroll</small>
            </span>
        </a>

        @if (company is not null)
        {
            <span class="secure-label">
                <svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z" /></svg>
                Secure employee portal
            </span>
        }
    </header>

    @if (isLoading)
    {
        <section class="loading-state">
            <span class="loader"></span>
            <p>Loading your workspace…</p>
        </section>
    }
    else if (company is null)
    {
        <section class="setup-section">
            <div class="setup-intro">
                <span class="kicker">One-time setup</span>
                <h1>Set up your company</h1>
                <p>Add your company name and logo. This information will appear on the welcome and login pages.</p>
            </div>

            <EditForm Model="companyForm" OnValidSubmit="SaveCompanyAsync" class="company-form" FormName="company-setup">
                <DataAnnotationsValidator />

                <div class="field-group">
                    <label for="company-name">Company name</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24"><path d="M4 20V7l8-3v16M4 20h16M12 9h8v11" /></svg>
                        <InputText id="company-name" class="text-input" @bind-Value="companyForm.CompanyName" placeholder="Enter official company name" />
                    </div>
                    <ValidationMessage For="() => companyForm.CompanyName" />
                </div>

                <div class="field-group">
                    <label>Company logo <span>Optional</span></label>
                    <label class="logo-picker">
                        <InputFile OnChange="HandleLogoAsync" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                        @if (logoPreview is not null)
                        {
                            <img src="@logoPreview" alt="Selected company logo" />
                            <span><strong>@logoFileName</strong><small>Click to change logo</small></span>
                        }
                        else
                        {
                            <span class="upload-icon"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M5 14v5h14v-5" /></svg></span>
                            <span><strong>Choose company logo</strong><small>PNG, JPG, WEBP or SVG · Max 2 MB</small></span>
                        }
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(formError))
                {
                    <div class="form-error" role="alert">@formError</div>
                }

                <button class="primary-button" type="submit" disabled="@isSaving">
                    @if (isSaving) { <span class="button-loader"></span> }
                    @(isSaving ? "Saving…" : "Save and continue")
                    @if (!isSaving) { <span aria-hidden="true">→</span> }
                </button>
            </EditForm>
        </section>
    }
    else
    {
        <section class="welcome-content">
            <div class="welcome-copy">
                <span class="kicker">Employee management system</span>
                <h1>Welcome to<br /><em>@company.CompanyName</em></h1>
                <p>Choose your portal below to securely access the attendance and payroll system.</p>
            </div>

            <div class="portal-grid" aria-label="Login options">
                <article class="portal-card admin-card">
                    <div class="portal-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z" /><path d="m9 12 2 2 4-4" /></svg>
                    </div>
                    <div class="portal-copy">
                        <span>Company access</span>
                        <h2>Administrator</h2>
                        <p>Sign in to manage company settings and system access.</p>
                    </div>
                    <a class="portal-button" href="/login/admin">Admin login <span>→</span></a>
                </article>

                <article class="portal-card hr-card">
                    <div class="portal-icon">
                        <svg viewBox="0 0 24 24"><path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 11l2 2 4-4" /></svg>
                    </div>
                    <div class="portal-copy">
                        <span>HR access</span>
                        <h2>HR Manager</h2>
                        <p>Sign in to manage employees and daily HR operations.</p>
                    </div>
                    <a class="portal-button" href="/login/hr">HR login <span>→</span></a>
                </article>
            </div>
        </section>
    }

    <footer class="site-footer">
        <span>© @DateTime.Now.Year @(company?.CompanyName ?? "Attendance & Payroll")</span>
        <span>Secure access · Authorized users only</span>
    </footer>
</main>

@code {
    private const long MaxLogoSize = 2 * 1024 * 1024;
    private CompanyProfile? company;
    private readonly CompanyFormModel companyForm = new();
    private byte[]? logoBytes;
    private string? logoPreview;
    private string? logoFileName;
    private string? formError;
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            company = await CompanyService.GetAsync();
        }
        catch (Exception)
        {
            formError = "Company profile could not be loaded. Please check the database connection.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLogoAsync(InputFileChangeEventArgs args)
    {
        formError = null;
        var file = args.File;
        string[] allowedTypes = ["image/png", "image/jpeg", "image/webp", "image/svg+xml"];

        if (!allowedTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            formError = "Please select a PNG, JPG, WEBP or SVG image.";
            return;
        }

        if (file.Size > MaxLogoSize)
        {
            formError = "Logo size must be less than 2 MB.";
            return;
        }

        await using var stream = file.OpenReadStream(MaxLogoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        logoBytes = memoryStream.ToArray();
        logoFileName = file.Name;
        logoPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(logoBytes)}";
    }

    private async Task SaveCompanyAsync()
    {
        if (isSaving || company is not null) return;

        isSaving = true;
        formError = null;
        try
        {
            company = await CompanyService.CreateAsync(companyForm.CompanyName, logoBytes);
        }
        catch (PostgresException exception) when (exception.SqlState == "23505")
        {
            company = await CompanyService.GetAsync();
        }
        catch (Exception)
        {
            formError = "Company profile could not be saved. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class CompanyFormModel
    {
        [Required(ErrorMessage = "Company name is required.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "Enter a company name between 2 and 150 characters.")]
        public string CompanyName { get; set; } = string.Empty;
    }
}
