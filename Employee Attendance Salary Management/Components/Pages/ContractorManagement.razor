@page "/dashboard/admin/settings/contractors"
@rendermode InteractiveServer
@attribute [Authorize(Roles="ADMIN")]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject AuthenticationStateProvider AuthState
@inject ContractorService Service
@inject BranchService BranchService

<PageTitle>Contractor Management</PageTitle>
<div class="sm-shell"><SettingsSidebar Active="contractors"/><main class="sm-main">
<header class="sm-header"><div><a href="/dashboard/admin">← Back to dashboard</a><span class="sm-kicker">Company settings</span><h1>Contractors</h1><p>Manage contractor profiles and branch assignments from one page.</p></div><button class="sm-primary" @onclick="OpenNew">+ Add contractor</button></header>
@if(message is not null){<div class="sm-notice @(isError?"error":null)">@message</div>}
<section class="sm-panel"><div class="sm-panel-head"><div><h2>All contractors</h2><p>@contractors.Count records · core.contractor and core.contractor_branch</p></div><input class="sm-search" value="@search" @oninput="e=>search=e.Value?.ToString()??string.Empty" placeholder="Search contractor, contact or city"/></div>
@if(loading){<div class="sm-empty">Loading contractors…</div>}else if(!Filtered.Any()){<div class="sm-empty">No contractors found.</div>}else{<div class="sm-table-wrap"><table class="sm-table"><thead><tr><th>Contractor</th><th>Contact</th><th>City</th><th>Assigned branches</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var x in Filtered){<tr><td><strong>@x.Name</strong><span class="sm-sub">@x.Code</span></td><td>@(x.ContactPerson??"—")<span class="sm-sub">@(x.PhoneNumber??x.Email??"")</span></td><td>@(x.City??"—")</td><td>@(x.ActiveBranchNames.Count==0?"None":string.Join(", ",x.ActiveBranchNames))</td><td><span class="sm-badge @(x.IsActive?"on":"off")">@(x.IsActive?"Active":"Inactive")</span></td><td><div class="sm-actions"><button @onclick="()=>View(x)">◉ View</button><button class="action-edit" @onclick="()=>Edit(x)">✎ Edit</button><button class="@(x.IsActive?"action-danger":"action-enable")" @onclick="()=>Toggle(x)">@(x.IsActive?"▣ Disable":"✓ Enable")</button></div></td></tr>}
</tbody></table></div>}</section></main></div>

@if(showForm){<div class="sm-modal-bg" @onclick="Close"><section class="sm-modal wide" @onclick:stopPropagation="true"><header><div><span>Contractor record</span><h2>@(form.Id is null?"Create contractor":"Edit contractor")</h2></div><button class="sm-close" @onclick="Close">×</button></header><EditForm class="sm-form" Model="form" OnValidSubmit="Save" FormName="contractor-form"><DataAnnotationsValidator/><div class="sm-grid">
<label class="sm-field">Code<InputText @bind-Value="form.Code" disabled="true" placeholder="Generated automatically"/></label><label class="sm-field">Contractor name *<InputText @bind-Value="form.Name"/><ValidationMessage For="()=>form.Name"/></label>
<label class="sm-field">Contact person<InputText @bind-Value="form.ContactPerson"/></label><label class="sm-field">Phone<InputText @bind-Value="form.PhoneNumber"/></label><label class="sm-field">Email<InputText type="email" @bind-Value="form.Email"/></label><label class="sm-field">City<InputText @bind-Value="form.City"/></label><label class="sm-field full">Address<InputTextArea @bind-Value="form.Address"/></label>
<div class="sm-field full"><span>Assigned branches</span><div class="sm-check-list">@foreach(var b in branches){<label><input type="checkbox" checked="@form.BranchIds.Contains(b.Id)" @onchange="e=>SetBranch(b.Id,e)"/> <span>@b.Name <small>(@b.Code)</small></span></label>}</div></div><label class="sm-check full"><InputCheckbox @bind-Value="form.IsActive"/> Active contractor</label></div>
@if(formError is not null){<div class="sm-form-error">@formError</div>}<footer class="sm-footer"><button type="button" class="sm-cancel" @onclick="Close">Cancel</button><button class="sm-save" disabled="@saving">@(saving?"Saving…":"Save contractor")</button></footer></EditForm></section></div>}

@if(selected is not null){<div class="sm-modal-bg" @onclick="CloseView"><section class="sm-modal" @onclick:stopPropagation="true"><header><div><span>Contractor details</span><h2>@selected.Name</h2></div><button class="sm-close" @onclick="CloseView">×</button></header><div class="sm-detail"><dl><div><dt>ID</dt><dd>@selected.Id</dd></div><div><dt>Code</dt><dd>@selected.Code</dd></div><div><dt>Contact person</dt><dd>@(selected.ContactPerson??"—")</dd></div><div><dt>Phone</dt><dd>@(selected.PhoneNumber??"—")</dd></div><div><dt>Email</dt><dd>@(selected.Email??"—")</dd></div><div><dt>City</dt><dd>@(selected.City??"—")</dd></div><div><dt>Address</dt><dd>@(selected.Address??"—")</dd></div><div><dt>Status</dt><dd>@(selected.IsActive?"Active":"Inactive")</dd></div><div style="grid-column:1/-1"><dt>Active branch assignments</dt><dd>@(selected.ActiveBranchNames.Count==0?"No branches assigned":string.Join(", ",selected.ActiveBranchNames))</dd></div></dl><footer class="sm-footer"><button class="sm-cancel" @onclick="CloseView">Close</button><button class="sm-save" @onclick="()=>EditFromView(selected)">Edit</button></footer></div></section></div>}

@code{
 private IReadOnlyList<ContractorItem> contractors=[];private IReadOnlyList<BranchListItem> branches=[];private ContractorFormModel form=new();private ContractorItem? selected;private Guid actor;private string search="";private string? message,formError;private bool isError,loading=true,saving,showForm;
 private IEnumerable<ContractorItem> Filtered=>contractors.Where(x=>string.IsNullOrWhiteSpace(search)||new[]{x.Name,x.Code,x.ContactPerson??"",x.City??""}.Any(v=>v.Contains(search,StringComparison.OrdinalIgnoreCase)));
 protected override async Task OnInitializedAsync(){try{var u=(await AuthState.GetAuthenticationStateAsync()).User;actor=Guid.Parse(u.FindFirstValue(ClaimTypes.NameIdentifier)!);await Reload();branches=await BranchService.GetAllAsync();}catch{Notice("Contractor data could not be loaded.",true);}finally{loading=false;}}
 private async Task Reload()=>contractors=await Service.GetAllAsync();private void OpenNew(){form=new(){IsActive=true};formError=null;showForm=true;}private void Edit(ContractorItem x){form=new(){Id=x.Id,Code=x.Code,Name=x.Name,ContactPerson=x.ContactPerson,PhoneNumber=x.PhoneNumber,Email=x.Email,Address=x.Address,City=x.City,IsActive=x.IsActive,BranchIds=x.ActiveBranchIds.ToHashSet()};formError=null;showForm=true;}private void SetBranch(Guid id,ChangeEventArgs e){if(e.Value is true)form.BranchIds.Add(id);else form.BranchIds.Remove(id);}private void Close(){if(!saving)showForm=false;}private void View(ContractorItem x)=>selected=x;private void CloseView()=>selected=null;private void EditFromView(ContractorItem x){selected=null;Edit(x);}
 private async Task Save(){saving=true;formError=null;try{await Service.SaveAsync(form,actor);await Reload();showForm=false;Notice("Contractor and branch assignments saved.");}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.UniqueViolation){formError="This contractor code already exists.";}catch{formError="Contractor could not be saved.";}finally{saving=false;}}
 private async Task Toggle(ContractorItem x){await Service.SetActiveAsync(x.Id,!x.IsActive,actor);await Reload();Notice("Contractor status updated.");}private void Notice(string x,bool error=false){message=x;isError=error;}
}
