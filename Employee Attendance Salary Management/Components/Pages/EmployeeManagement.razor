@page "/employees"
@attribute [StreamRendering]
@attribute [Authorize(Roles="ADMIN,HR_MANAGER")]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject AuthenticationStateProvider AuthState
@inject EmployeeService Service
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager Nav

<PageTitle>Employees</PageTitle>
<div class="emp-shell"><EmployeeSidebar Active="employees" IsAdmin="isAdmin"/><main class="emp-main">
 <header class="emp-page-head"><div><span>People operations</span><h1>Employee directory</h1><p>Profiles, assignments, salary, bank details, documents and biometrics.</p></div><button class="emp-primary" @onclick="OpenWizard">+ Add employee</button></header>
 @if(message is not null){<div class="emp-notice @(isError?"error":null)">@message</div>}
 <section class="emp-stat-grid">
  <article><i class="blue">♙</i><div><strong>@employees.Count</strong><span>Total employees</span></div></article>
  <article><i class="green">✓</i><div><strong>@employees.Count(x=>x.EmploymentStatus=="active")</strong><span>Active workforce</span></div></article>
  <article><i class="orange">▦</i><div><strong>@employees.Select(x=>x.BranchId).Where(x=>x is not null).Distinct().Count()</strong><span>Branches covered</span></div></article>
  <article><i class="purple">◫</i><div><strong>@employees.Count(x=>x.EmploymentStatus=="draft")</strong><span>Draft profiles</span></div></article>
 </section>
 <section class="emp-panel"><div class="emp-panel-head"><div><h2>All employees</h2><p>Open an employee to manage every information layer.</p></div><div class="emp-filters"><input value="@search" @oninput="e=>search=e.Value?.ToString()??string.Empty" placeholder="Search name, number, branch…"/><select @bind="statusFilter"><option value="">All statuses</option><option value="active">Active</option><option value="draft">Draft</option><option value="suspended">Suspended</option><option value="terminated">Terminated</option><option value="retired">Retired</option></select></div></div>
 @if(loading){<div class="emp-empty">Loading employees…</div>}else if(!Filtered.Any()){<div class="emp-empty"><b>No employees found</b><span>Change the filters or add the first employee.</span></div>}else{
 <div class="emp-table-wrap"><table class="emp-table"><thead><tr><th>Employee</th><th>Assignment</th><th>Contact</th><th>Employment</th><th>Salary</th><th></th></tr></thead><tbody>
 @foreach(var x in Filtered){<tr><td><div class="emp-person"><div><strong>@x.FullName</strong><span>@x.EmployeeNo · @(x.PayrollNo??"No payroll #")</span></div></div></td><td><strong>@(x.DesignationName??"Not assigned")</strong><span>@(x.DepartmentName??"—") · @(x.BranchName??"—")</span></td><td><strong>@(x.MobilePhone??"No phone")</strong><span>@(x.Email??"No email")</span></td><td><span class="emp-status @x.EmploymentStatus">@Title(x.EmploymentStatus)</span><small>@Title(x.EmploymentType)</small></td><td><strong>@(x.BaseSalary?.ToString("N0")??"—")</strong><span>Current base</span></td><td><button class="emp-open" @onclick="()=>OpenEmployee(x.Id)">Open →</button></td></tr>}
 </tbody></table></div>}
 </section>
</main></div>

@if(showWizard){<div class="emp-modal-bg"><section class="emp-wizard"><header><div><span>New employee · Step @step of 6</span><h2>@StepTitle</h2></div><button @onclick="CloseWizard">×</button></header><div class="emp-progress">@for(var i=1;i<=6;i++){var n=i;<button class="@(step==n?"active":step>n?"done":null)" @onclick="()=>GoStep(n)"><i>@(step>n?"✓":n)</i><span>@StepName(n)</span></button>}</div><div class="emp-wizard-body">
 @if(step==1){<div class="emp-layer-intro"><b>Personal identity</b><span>Basic identity and employee photograph.</span></div><div class="emp-form-grid"><label>First name *<InputText @bind-Value="draft.Profile.FirstName"/></label><label>Last name<InputText @bind-Value="draft.Profile.LastName"/></label><label>Father name<InputText @bind-Value="draft.Profile.FatherName"/></label><label>National ID / CNIC<InputText @bind-Value="draft.Profile.NationalId" placeholder="Protected in database"/></label><label>Date of birth<InputDate @bind-Value="draft.Profile.DateOfBirth"/></label><label>Gender<InputSelect @bind-Value="draft.Profile.Gender"><option value="">Select</option><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></InputSelect></label><label class="full">Employee photo<InputFile OnChange="ReadPhoto" accept="image/png,image/jpeg,image/webp"/><small>PNG, JPG or WebP · maximum 3 MB</small></label></div>}
 else if(step==2){<div class="emp-layer-intro"><b>Contact & address</b><span>How the employee can be reached.</span></div><div class="emp-form-grid"><label>Mobile phone<InputText @bind-Value="draft.Profile.MobilePhone"/></label><label>Email<InputText @bind-Value="draft.Profile.Email"/></label><label class="full">Street address<InputTextArea @bind-Value="draft.Profile.Address"/></label><label>City<InputText @bind-Value="draft.Profile.City"/></label><label>District<InputText @bind-Value="draft.Profile.District"/></label><label>Province<InputText @bind-Value="draft.Profile.Province"/></label><label>Postal code<InputText @bind-Value="draft.Profile.PostalCode"/></label></div>}
 else if(step==3){<div class="emp-layer-intro"><b>Employment</b><span>Joining dates, status and employee category.</span></div><div class="emp-form-grid"><label>Hire date *<InputDate @bind-Value="draft.Profile.HireDate"/></label><label>Confirmation date<InputDate @bind-Value="draft.Profile.ConfirmationDate"/></label><label>Employment type<InputSelect @bind-Value="draft.Profile.EmploymentType"><option value="permanent">Permanent</option><option value="contract">Contract</option><option value="temporary">Temporary</option><option value="daily_wage">Daily wage</option><option value="intern">Intern</option></InputSelect></label><label>Status<InputSelect @bind-Value="draft.Profile.EmploymentStatus"><option value="draft">Draft</option><option value="active">Active</option><option value="suspended">Suspended</option></InputSelect></label><label>Payment channel<InputSelect @bind-Value="draft.Profile.PreferredPaymentChannel"><option value="cash">Cash</option><option value="bank">Bank</option></InputSelect></label>@if(draft.Profile.PreferredPaymentChannel=="bank"){<label>Bank payment type<InputSelect @bind-Value="draft.Profile.PreferredBankPaymentType"><option value="">Select</option><option value="online_transfer">Online transfer</option><option value="cheque">Cheque</option></InputSelect></label>}</div>}
 else if(step==4){<div class="emp-layer-intro"><b>Organization assignment</b><span>Place the employee in the correct reporting structure.</span></div><div class="emp-form-grid"><label>Branch *<InputSelect @bind-Value="draft.Assignment.BranchId"><option value="">Select branch</option>@foreach(var b in branches.Where(x=>x.IsActive)){<option value="@b.Id">@b.Name</option>}</InputSelect></label><label>Department *<InputSelect @bind-Value="draft.Assignment.DepartmentId"><option value="">Select department</option>@foreach(var d in departments.Where(x=>x.IsActive&&x.BranchId==draft.Assignment.BranchId)){<option value="@d.Id">@d.Name</option>}</InputSelect></label><label>Designation *<InputSelect @bind-Value="draft.Assignment.DesignationId"><option value="">Select designation</option>@foreach(var d in designations.Where(x=>x.IsActive&&x.DepartmentId==draft.Assignment.DepartmentId)){<option value="@d.Id">@d.Name</option>}</InputSelect></label><label>Reports to<InputSelect @bind-Value="draft.Assignment.ManagerEmployeeId"><option value="">No manager</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Effective from<InputDate @bind-Value="draft.Assignment.EffectiveFrom"/></label></div>}
 else if(step==5){<div class="emp-layer-intro"><b>Salary & bank</b><span>Initial compensation and optional bank account.</span></div><label class="emp-switch"><InputCheckbox @bind-Value="draft.AddCompensation"/><span><b>Add starting salary</b><small>Create the first compensation period.</small></span></label>@if(draft.AddCompensation){<div class="emp-form-grid"><label>Base salary<InputNumber @bind-Value="draft.Compensation.BaseSalary"/></label><label>Pay frequency<InputSelect @bind-Value="draft.Compensation.PayFrequency"><option value="monthly">Monthly</option><option value="daily">Daily</option><option value="hourly">Hourly</option></InputSelect></label><label>Effective from<InputDate @bind-Value="draft.Compensation.EffectiveFrom"/></label><label>Reason<InputText @bind-Value="draft.Compensation.Reason" placeholder="Starting salary"/></label></div>}<label class="emp-switch"><InputCheckbox @bind-Value="draft.AddBankAccount"/><span><b>Add bank account</b><small>Only needed when salary is paid through bank.</small></span></label>@if(draft.AddBankAccount){<div class="emp-form-grid"><label>Bank name<InputText @bind-Value="draft.Bank.BankName"/></label><label>Account title<InputText @bind-Value="draft.Bank.AccountTitle"/></label><label>IBAN<InputText @bind-Value="draft.Bank.Iban"/></label><label>Account number<InputText @bind-Value="draft.Bank.AccountNumber"/></label></div>}}
 else{<div class="emp-review"><div class="emp-review-icon">✓</div><h3>Ready to create employee</h3><p>The profile and initial assignment will be saved together. Salary and bank details are included according to your selections.</p><dl><div><dt>Name</dt><dd>@draft.Profile.FirstName @draft.Profile.LastName</dd></div><div><dt>Branch</dt><dd>@branches.FirstOrDefault(x=>x.Id==draft.Assignment.BranchId)?.Name</dd></div><div><dt>Department</dt><dd>@departments.FirstOrDefault(x=>x.Id==draft.Assignment.DepartmentId)?.Name</dd></div><div><dt>Designation</dt><dd>@designations.FirstOrDefault(x=>x.Id==draft.Assignment.DesignationId)?.Name</dd></div></dl></div>}
 @if(formError is not null){<div class="emp-form-error">@formError</div>}
 </div><footer><button class="secondary" @onclick="CloseWizard">Cancel</button><div>@if(step>1){<button class="secondary" @onclick="Previous">← Back</button>}@if(step<6){<button class="primary" @onclick="Next">Continue →</button>}else{<button class="primary" disabled="@saving" @onclick="CreateEmployee">@(saving?"Creating…":"Create employee")</button>}</div></footer></section></div>}

@code{
 private IReadOnlyList<EmployeeListItem> employees=[];private IReadOnlyList<BranchListItem> branches=[];private IReadOnlyList<DepartmentItem> departments=[];private IReadOnlyList<DesignationItem> designations=[];private EmployeeOnboardingModel draft=new();private byte[]? photo;private Guid actor;private bool allAccess,isAdmin,loading=true,showWizard,saving,isError;private int step=1;private string search="",statusFilter="";private string? message,formError;
 private IEnumerable<EmployeeListItem> Filtered=>employees.Where(x=>(string.IsNullOrWhiteSpace(statusFilter)||x.EmploymentStatus==statusFilter)&&(string.IsNullOrWhiteSpace(search)||new[]{x.FullName,x.EmployeeNo,x.PayrollNo??"",x.BranchName??"",x.DepartmentName??"",x.DesignationName??""}.Any(v=>v.Contains(search,StringComparison.OrdinalIgnoreCase))));
 private string StepTitle=>StepName(step);private static string StepName(int x)=>x switch{1=>"Personal",2=>"Contact",3=>"Employment",4=>"Assignment",5=>"Salary & bank",_=>"Review"};private static string Title(string s)=>System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(s.Replace('_',' '));
 protected override async Task OnInitializedAsync(){try{var p=(await AuthState.GetAuthenticationStateAsync()).User;actor=Guid.Parse(p.FindFirstValue(ClaimTypes.NameIdentifier)!);allAccess=bool.TryParse(p.FindFirstValue("all_branch_access"),out var a)&&a;isAdmin=p.IsInRole("ADMIN");var employeeTask=Service.GetAllAsync(actor,isAdmin||allAccess);var branchTask=BranchService.GetAllAsync();var departmentTask=OrganizationService.GetDepartmentsAsync();var designationTask=OrganizationService.GetDesignationsAsync();await Task.WhenAll(employeeTask,branchTask,departmentTask,designationTask);employees=await employeeTask;branches=await branchTask;departments=await departmentTask;designations=await designationTask;}catch(Exception){message="Employee data could not be loaded.";isError=true;}finally{loading=false;}}
 private async Task Reload()=>employees=await Service.GetAllAsync(actor,isAdmin||allAccess);
 private void OpenEmployee(Guid id)=>Nav.NavigateTo($"/employees/{id}");
 private void OpenWizard(){draft=new(){Profile=new(){EmploymentStatus="active",EmploymentType="permanent",PreferredPaymentChannel="cash",HireDate=DateOnly.FromDateTime(DateTime.Today)},Assignment=new(){EffectiveFrom=DateOnly.FromDateTime(DateTime.Today)},Compensation=new(){EffectiveFrom=DateOnly.FromDateTime(DateTime.Today),PayFrequency="monthly",Reason="Starting salary"},Bank=new(){IsPrimary=true},AddCompensation=true};photo=null;step=1;formError=null;showWizard=true;}
 private void CloseWizard(){if(!saving)showWizard=false;}private void Previous(){formError=null;if(step>1)step--;}private void GoStep(int n){if(n<step){step=n;formError=null;}}private void Next(){formError=ValidateStep();if(formError is null)step++;}
 private string? ValidateStep()=>step switch{1 when string.IsNullOrWhiteSpace(draft.Profile.FirstName)=>"First name is required.",3 when draft.Profile.PreferredPaymentChannel=="bank"&&string.IsNullOrWhiteSpace(draft.Profile.PreferredBankPaymentType)=>"Select the bank payment type.",4 when draft.Assignment.BranchId is null||draft.Assignment.DepartmentId is null||draft.Assignment.DesignationId is null=>"Select branch, department and designation.",5 when draft.AddCompensation&&draft.Compensation.BaseSalary<0=>"Salary cannot be negative.",5 when draft.AddBankAccount&&(string.IsNullOrWhiteSpace(draft.Bank.BankName)||string.IsNullOrWhiteSpace(draft.Bank.AccountTitle))=>"Bank name and account title are required.",_=>null};
 private async Task ReadPhoto(InputFileChangeEventArgs e){try{photo=await ReadFile(e.File,3*1024*1024);formError=null;}catch(Exception ex){formError=ex.Message;}}
 private static async Task<byte[]> ReadFile(IBrowserFile f,long max){await using var s=f.OpenReadStream(max);using var m=new MemoryStream();await s.CopyToAsync(m);return m.ToArray();}
 private async Task CreateEmployee(){formError=ValidateStep();if(formError is not null)return;saving=true;try{var id=await Service.SaveOnboardingAsync(draft,photo,actor);showWizard=false;await Reload();Nav.NavigateTo($"/employees/{id}");}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.ExclusionViolation){formError="The selected assignment or salary period overlaps an existing period.";}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.UniqueViolation){formError="Employee number, payroll number or national ID already exists.";}catch(Exception e){formError=e is InvalidOperationException?e.Message:"Employee could not be created.";}finally{saving=false;}}
}
