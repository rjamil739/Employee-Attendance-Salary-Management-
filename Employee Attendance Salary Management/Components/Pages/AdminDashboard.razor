@page "/dashboard/admin"
@attribute [StreamRendering]
@attribute [Authorize(Roles = "ADMIN")]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Components.Dashboard
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DashboardService DashboardService
@inject CompanyProfileService CompanyService

<PageTitle>Admin Dashboard</PageTitle>

@if (summary is null)
{
    <div class="dashboard-loading">Loading dashboard…</div>
}
else
{
    <DashboardView Summary="summary" DisplayName="@displayName" Company="company" IsAdmin="true" />
}

@code {
    private DashboardSummary? summary;
    private CompanyProfile? company;
    private string displayName = "Administrator";

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var userId = Guid.Parse(principal.FindFirstValue(ClaimTypes.NameIdentifier)!);
        displayName = principal.FindFirstValue("display_name") ?? principal.Identity?.Name ?? "Administrator";
        var companyTask = CompanyService.GetAsync();
        var summaryTask = DashboardService.GetAsync(userId, true);
        await Task.WhenAll(companyTask, summaryTask);
        company = await companyTask;
        summary = await summaryTask;
    }
}
