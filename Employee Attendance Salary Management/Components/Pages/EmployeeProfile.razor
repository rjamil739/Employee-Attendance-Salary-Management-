@page "/employees/{EmployeeId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles="ADMIN,HR_MANAGER")]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject AuthenticationStateProvider AuthState
@inject EmployeeService Service
@inject BranchService BranchService
@inject OrganizationService OrganizationService

<PageTitle>@(data is null?"Employee":FullName)</PageTitle>
<div class="emp-shell"><EmployeeSidebar Active="employees" IsAdmin="isAdmin"/><main class="emp-main">
 @if(loading){<div class="emp-empty page">Loading employee workspace…</div>}
 else if(data is null){<div class="emp-empty page"><b>Employee not found</b><a href="/employees">Back to employees</a></div>}
 else{
 <a class="emp-back" href="/employees">← Employee directory</a>
 <section class="emp-profile-head"><div class="emp-profile-photo">@ProfileAvatar</div><div><span>@data.Employee.EmployeeNo · @(data.Employee.PayrollNo??"No payroll number")</span><h1>@FullName</h1><p>@CurrentDesignation · @CurrentDepartment · @CurrentBranch</p></div><span class="emp-status @data.Employee.EmploymentStatus">@Title(data.Employee.EmploymentStatus)</span></section>
 @if(message is not null){<div class="emp-notice @(isError?"error":null)">@message</div>}
 <nav class="emp-layer-tabs">@foreach(var item in tabs){<button class="@(tab==item.Key?"active":null)" @onclick="()=>SetTab(item.Key)"><i>@item.Icon</i><span>@item.Label</span><small>@item.Note</small></button>}</nav>
 <section class="emp-workspace">
 @if(tab=="profile"){
  <header><div><h2>Profile information</h2><p>Identity, contact and employment details.</p></div><button class="emp-primary small" @onclick="BeginProfileEdit">✎ Edit profile</button></header>
  @if(editProfile){<EditForm Model="profile" OnValidSubmit="SaveProfile" FormName="employee-profile"><DataAnnotationsValidator/><div class="emp-section-title">Personal identity</div><div class="emp-form-grid"><label>First name *<InputText @bind-Value="profile.FirstName"/></label><label>Last name<InputText @bind-Value="profile.LastName"/></label><label>Father name<InputText @bind-Value="profile.FatherName"/></label><label>New CNIC / national ID<InputText @bind-Value="profile.NationalId" placeholder="Leave blank to keep current"/></label><label>Date of birth<InputDate @bind-Value="profile.DateOfBirth"/></label><label>Gender<InputSelect @bind-Value="profile.Gender"><option value="">Select</option><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></InputSelect></label><label class="full">Replace photo<InputFile OnChange="ReadProfilePhoto" accept="image/*"/></label></div><div class="emp-section-title">Contact & address</div><div class="emp-form-grid"><label>Mobile<InputText @bind-Value="profile.MobilePhone"/></label><label>Email<InputText @bind-Value="profile.Email"/></label><label class="full">Address<InputTextArea @bind-Value="profile.Address"/></label><label>City<InputText @bind-Value="profile.City"/></label><label>District<InputText @bind-Value="profile.District"/></label><label>Province<InputText @bind-Value="profile.Province"/></label><label>Postal code<InputText @bind-Value="profile.PostalCode"/></label></div><div class="emp-section-title">Employment</div><div class="emp-form-grid"><label>Hire date<InputDate @bind-Value="profile.HireDate"/></label><label>Confirmation date<InputDate @bind-Value="profile.ConfirmationDate"/></label><label>Termination date<InputDate @bind-Value="profile.TerminationDate"/></label><label>Status<InputSelect @bind-Value="profile.EmploymentStatus"><option value="draft">Draft</option><option value="active">Active</option><option value="suspended">Suspended</option><option value="terminated">Terminated</option><option value="retired">Retired</option></InputSelect></label><label>Employment type<InputSelect @bind-Value="profile.EmploymentType"><option value="permanent">Permanent</option><option value="contract">Contract</option><option value="temporary">Temporary</option><option value="daily_wage">Daily wage</option><option value="intern">Intern</option></InputSelect></label><label>Payment channel<InputSelect @bind-Value="profile.PreferredPaymentChannel"><option value="cash">Cash</option><option value="bank">Bank</option></InputSelect></label>@if(profile.PreferredPaymentChannel=="bank"){<label>Bank payment type<InputSelect @bind-Value="profile.PreferredBankPaymentType"><option value="online_transfer">Online transfer</option><option value="cheque">Cheque</option></InputSelect></label>}</div>@EditorError<div class="emp-editor-actions"><button type="button" @onclick="CancelEditor">Cancel</button><button class="save" disabled="@saving">Save profile</button></div></EditForm>}
  else{<div class="emp-detail-grid"><article><span>Employee number</span><b>@data.Employee.EmployeeNo</b></article><article><span>Payroll number</span><b>@(data.Employee.PayrollNo??"—")</b></article><article><span>Father name</span><b>@(data.Employee.FatherName??"—")</b></article><article><span>Date of birth</span><b>@Date(data.Employee.DateOfBirth)</b></article><article><span>Gender</span><b>@Title(data.Employee.Gender??"Not specified")</b></article><article><span>Mobile phone</span><b>@(data.Employee.MobilePhone??"—")</b></article><article><span>Email</span><b>@(data.Employee.Email??"—")</b></article><article><span>Address</span><b>@Address</b></article><article><span>Hire date</span><b>@Date(data.Employee.HireDate)</b></article><article><span>Confirmation</span><b>@Date(data.Employee.ConfirmationDate)</b></article><article><span>Employment type</span><b>@Title(data.Employee.EmploymentType)</b></article><article><span>Payment channel</span><b>@Title(data.Employee.PreferredPaymentChannel)</b></article></div>}
 }
 else if(tab=="assignment"){
  <header><div><h2>Assignment history</h2><p>Branch, department, designation and reporting manager periods.</p></div><button class="emp-primary small" @onclick="NewAssignment">+ Add assignment</button></header>
  @if(editor=="assignment"){<EditForm Model="assignment" OnValidSubmit="SaveAssignment" FormName="assignment"><DataAnnotationsValidator/><div class="emp-form-grid"><label>Branch<InputSelect @bind-Value="assignment.BranchId"><option value="">Select</option>@foreach(var x in branches.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Department<InputSelect @bind-Value="assignment.DepartmentId"><option value="">Select</option>@foreach(var x in departments.Where(x=>x.IsActive&&x.BranchId==assignment.BranchId)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Designation<InputSelect @bind-Value="assignment.DesignationId"><option value="">Select</option>@foreach(var x in designations.Where(x=>x.IsActive&&x.DepartmentId==assignment.DepartmentId)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Reports to<InputSelect @bind-Value="assignment.ManagerEmployeeId"><option value="">No manager</option>@foreach(var x in employeeOptions.Where(x=>x.Id!=EmployeeId)){<option value="@x.Id">@x.Name (@x.EmployeeNo)</option>}</InputSelect></label><label>Effective from<InputDate @bind-Value="assignment.EffectiveFrom"/></label><label>Effective to<InputDate @bind-Value="assignment.EffectiveTo"/></label></div>@EditorError @EditorActions}</EditForm>}
  @HistoryTable("assignment")
 }
 else if(tab=="salary"){
  <header><div><h2>Compensation history</h2><p>Effective-dated salary records preserve the full audit trail.</p></div><button class="emp-primary small" @onclick="NewCompensation">+ Add salary period</button></header>
  @if(editor=="salary"){<EditForm Model="compensation" OnValidSubmit="SaveCompensation" FormName="compensation"><DataAnnotationsValidator/><div class="emp-form-grid"><label>Base salary<InputNumber @bind-Value="compensation.BaseSalary"/></label><label>Pay frequency<InputSelect @bind-Value="compensation.PayFrequency"><option value="monthly">Monthly</option><option value="daily">Daily</option><option value="hourly">Hourly</option></InputSelect></label><label>Effective from<InputDate @bind-Value="compensation.EffectiveFrom"/></label><label>Effective to<InputDate @bind-Value="compensation.EffectiveTo"/></label><label class="full">Reason<InputText @bind-Value="compensation.Reason"/></label></div>@EditorError @EditorActions}</EditForm>}
  @HistoryTable("salary")
 }
 else if(tab=="bank"){
  <header><div><h2>Bank accounts</h2><p>Protected payment details; only one account can be primary.</p></div><button class="emp-primary small" @onclick="NewBank">+ Add bank account</button></header>
  @if(editor=="bank"){<EditForm Model="bank" OnValidSubmit="SaveBank" FormName="bank"><DataAnnotationsValidator/><div class="emp-form-grid"><label>Bank name<InputText @bind-Value="bank.BankName"/></label><label>Account title<InputText @bind-Value="bank.AccountTitle"/></label><label>IBAN<InputText @bind-Value="bank.Iban"/></label><label>Account number<InputText @bind-Value="bank.AccountNumber"/></label><label class="emp-switch full"><InputCheckbox @bind-Value="bank.IsPrimary"/><span><b>Primary salary account</b><small>Other accounts will automatically become secondary.</small></span></label></div>@EditorError @EditorActions}</EditForm>}
  <div class="emp-card-list">@foreach(var x in data.BankAccounts){<article><i>▤</i><div><b>@x.BankName @if(x.IsPrimary){<span class="emp-status active">Primary</span>}</b><span>@x.AccountTitle · @(x.Iban??x.AccountNumber??"Protected details")</span></div><button @onclick="()=>EditBank(x)">Edit</button></article>}@if(!data.BankAccounts.Any()){<div class="emp-empty">No bank accounts added.</div>}</div>
 }
 else if(tab=="documents"){
  <header><div><h2>Employee documents</h2><p>Contracts, identity documents, certificates and other files.</p></div><button class="emp-primary small" @onclick="NewDocument">+ Upload document</button></header>
  @if(editor=="document"){<div class="emp-form-grid"><label>Document type<select @bind="documentType"><option>CNIC / National ID</option><option>Employment contract</option><option>Education certificate</option><option>Experience letter</option><option>Other</option></select></label><label>Expiry date<InputDate @bind-Value="documentExpiry"/></label><label class="full">Choose file<InputFile OnChange="e=>documentFile=e.File"/></label></div>@EditorError<div class="emp-editor-actions"><button @onclick="CancelEditor">Cancel</button><button class="save" disabled="@saving" @onclick="SaveDocument">Upload document</button></div>}
  <div class="emp-card-list">@foreach(var x in data.Documents){<article><i>▧</i><div><b>@x.DocumentType</b><span>@x.OriginalFileName · @(x.ExpiresOn is null?"No expiry":$"Expires {x.ExpiresOn:dd MMM yyyy}")</span></div><a href="@x.ObjectKey" target="_blank">Open</a><button class="danger" @onclick="()=>DeleteDocument(x)">Remove</button></article>}@if(!data.Documents.Any()){<div class="emp-empty">No documents uploaded.</div>}</div>
 }
 else{
  <header><div><h2>Fingerprint registry</h2><p>Ten-finger template support with optional preview image.</p></div><button class="emp-primary small" @onclick="NewFingerprint">+ Register fingerprint</button></header>
  @if(editor=="fingerprint"){<div class="emp-form-grid"><label>Finger<select @bind="fingerType">@foreach(var x in fingers){<option value="@x.Key">@x.Value</option>}</select></label><label>Template format<input @bind="templateFormat" placeholder="e.g. ISO 19794-2"/></label><label>Template file *<InputFile OnChange="e=>templateFile=e.File"/></label><label>Fingerprint image<InputFile OnChange="e=>fingerImageFile=e.File" accept="image/*"/></label></div>@EditorError<div class="emp-editor-actions"><button @onclick="CancelEditor">Cancel</button><button class="save" disabled="@saving" @onclick="SaveFingerprint">Save fingerprint</button></div>}
  <div class="emp-finger-grid">@foreach(var x in data.Fingerprints){<article class="@(!x.IsActive?"inactive":null)"><div>@if(x.ImageDataUrl is not null){<img src="@x.ImageDataUrl" alt=""/>}else{<i>⌁</i>}</div><b>@FingerName(x.FingerType)</b><span>@(x.TemplateFormat??"Unknown format")</span><button @onclick="()=>ToggleFingerprint(x)">@(x.IsActive?"Disable":"Enable")</button></article>}@if(!data.Fingerprints.Any()){<div class="emp-empty">No fingerprints registered.</div>}</div>
 }
 </section>}
</main></div>

@code{
 [Parameter]public Guid EmployeeId{get;set;}private EmployeeWorkspaceData? data;private IReadOnlyList<BranchListItem> branches=[];private IReadOnlyList<DepartmentItem> departments=[];private IReadOnlyList<DesignationItem> designations=[];private IReadOnlyList<EmployeeOption> employeeOptions=[];private EmployeeEditorModel profile=new();private EmployeeAssignmentForm assignment=new();private EmployeeCompensationForm compensation=new();private EmployeeBankForm bank=new();private byte[]? profilePhoto;private IBrowserFile? documentFile,templateFile,fingerImageFile;private string documentType="CNIC / National ID",fingerType="right_thumb",templateFormat="ISO 19794-2",tab="profile",editor="";private DateOnly? documentExpiry;private Guid actor;private bool isAdmin,allAccess,loading=true,saving,editProfile,isError;private string? message,editorError;
 private readonly (string Key,string Label,string Icon,string Note)[] tabs=[("profile","Profile","♙","Personal"),("assignment","Assignment","▦","Organization"),("salary","Salary","₨","Compensation"),("bank","Bank","▤","Payment"),("documents","Documents","▧","Files"),("fingerprints","Fingerprints","⌁","Biometric")];
 private readonly Dictionary<string,string> fingers=new(){{"right_thumb","Right thumb"},{"right_index","Right index"},{"right_middle","Right middle"},{"right_ring","Right ring"},{"right_little","Right little"},{"left_thumb","Left thumb"},{"left_index","Left index"},{"left_middle","Left middle"},{"left_ring","Left ring"},{"left_little","Left little"}};
 private string FullName=>data is null?"Employee":string.Join(' ',new[]{data.Employee.FirstName,data.Employee.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x)));private string CurrentBranch=>data?.Assignments.FirstOrDefault(x=>x.EffectiveTo is null)?.BranchName??"No branch";private string CurrentDepartment=>data?.Assignments.FirstOrDefault(x=>x.EffectiveTo is null)?.DepartmentName??"No department";private string CurrentDesignation=>data?.Assignments.FirstOrDefault(x=>x.EffectiveTo is null)?.DesignationName??"Not assigned";private string Address=>string.Join(", ",new[]{data?.Employee.Address,data?.Employee.City,data?.Employee.District,data?.Employee.Province,data?.Employee.PostalCode}.Where(x=>!string.IsNullOrWhiteSpace(x)));private string FingerName(string key)=>fingers.TryGetValue(key,out var x)?x:key;
 private RenderFragment ProfileAvatar=>b=>{var url=ImageData.ToDataUrl(data?.Employee.ExistingPhoto);if(url is not null){b.OpenElement(0,"img");b.AddAttribute(1,"src",url);b.CloseElement();}else{b.OpenElement(2,"span");b.AddContent(3,string.Concat(FullName.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0]))));b.CloseElement();}};
 protected override async Task OnInitializedAsync(){try{var p=(await AuthState.GetAuthenticationStateAsync()).User;actor=Guid.Parse(p.FindFirstValue(ClaimTypes.NameIdentifier)!);isAdmin=p.IsInRole("ADMIN");allAccess=bool.TryParse(p.FindFirstValue("all_branch_access"),out var x)&&x;branches=await BranchService.GetAllAsync();departments=await OrganizationService.GetDepartmentsAsync();designations=await OrganizationService.GetDesignationsAsync();var all=await Service.GetAllAsync(actor,isAdmin||allAccess);employeeOptions=all.Select(x=>new EmployeeOption(x.Id,x.FullName,x.EmployeeNo)).ToList();await Reload();}catch(Exception){message="Employee workspace could not be loaded.";isError=true;}finally{loading=false;}}
 private async Task Reload()=>data=employeeOptions.Any(x=>x.Id==EmployeeId)?await Service.GetWorkspaceAsync(EmployeeId):null;private void SetTab(string value){tab=value;CancelEditor();}private static string Title(string x)=>System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(x.Replace('_',' '));private static string Date(DateOnly? x)=>x?.ToString("dd MMM yyyy")??"—";
 private void BeginProfileEdit(){profile=CopyProfile(data!.Employee);editProfile=true;editorError=null;profilePhoto=null;}private void CancelEditor(){editor="";editProfile=false;editorError=null;}
 private static EmployeeEditorModel CopyProfile(EmployeeEditorModel x)=>new(){Id=x.Id,UserAccountId=x.UserAccountId,EmployeeNo=x.EmployeeNo,PayrollNo=x.PayrollNo,FirstName=x.FirstName,LastName=x.LastName,FatherName=x.FatherName,ExistingPhoto=x.ExistingPhoto,DateOfBirth=x.DateOfBirth,Gender=x.Gender,Email=x.Email,MobilePhone=x.MobilePhone,Address=x.Address,City=x.City,District=x.District,Province=x.Province,PostalCode=x.PostalCode,HireDate=x.HireDate,ConfirmationDate=x.ConfirmationDate,TerminationDate=x.TerminationDate,EmploymentStatus=x.EmploymentStatus,EmploymentType=x.EmploymentType,PreferredPaymentChannel=x.PreferredPaymentChannel,PreferredBankPaymentType=x.PreferredBankPaymentType};
 private async Task ReadProfilePhoto(InputFileChangeEventArgs e){try{profilePhoto=await ReadFile(e.File,3*1024*1024);editorError=null;}catch(Exception ex){editorError=ex.Message;}}
 private async Task SaveProfile()=>await Run(async()=>await Service.SaveProfileAsync(profile,profilePhoto,profilePhoto is not null,!string.IsNullOrWhiteSpace(profile.NationalId),actor),"Profile updated.");
 private void NewAssignment(){assignment=new(){EffectiveFrom=DateOnly.FromDateTime(DateTime.Today)};editor="assignment";editorError=null;}private void EditAssignment(EmployeeAssignmentItem x){assignment=new(){Id=x.Id,BranchId=x.BranchId,DepartmentId=x.DepartmentId,DesignationId=x.DesignationId,ManagerEmployeeId=x.ManagerEmployeeId,EffectiveFrom=x.EffectiveFrom,EffectiveTo=x.EffectiveTo};editor="assignment";}
 private async Task SaveAssignment()=>await Run(async()=>await Service.SaveAssignmentAsync(EmployeeId,assignment,actor),"Assignment saved.");
 private void NewCompensation(){compensation=new(){EffectiveFrom=DateOnly.FromDateTime(DateTime.Today),PayFrequency="monthly"};editor="salary";editorError=null;}private void EditCompensation(EmployeeCompensationItem x){compensation=new(){Id=x.Id,BaseSalary=x.BaseSalary,PayFrequency=x.PayFrequency,EffectiveFrom=x.EffectiveFrom,EffectiveTo=x.EffectiveTo,Reason=x.Reason};editor="salary";}
 private async Task SaveCompensation()=>await Run(async()=>await Service.SaveCompensationAsync(EmployeeId,compensation,actor),"Compensation saved.");
 private void NewBank(){bank=new(){IsPrimary=!data!.BankAccounts.Any()};editor="bank";editorError=null;}private void EditBank(EmployeeBankItem x){bank=new(){Id=x.Id,BankName=x.BankName,AccountTitle=x.AccountTitle,Iban=x.Iban,AccountNumber=x.AccountNumber,IsPrimary=x.IsPrimary};editor="bank";}
 private async Task SaveBank()=>await Run(async()=>await Service.SaveBankAsync(EmployeeId,bank,actor),"Bank account saved.");
 private void NewDocument(){documentFile=null;documentType="CNIC / National ID";documentExpiry=null;editor="document";editorError=null;}private async Task SaveDocument(){if(documentFile is null){editorError="Choose a document file.";return;}try{var bytes=await ReadFile(documentFile,10*1024*1024);await Run(async()=>await Service.AddDocumentAsync(EmployeeId,documentType,documentFile.Name,documentFile.ContentType,bytes,documentExpiry,actor),"Document uploaded.");}catch(Exception e){editorError=e.Message;}}
 private async Task DeleteDocument(EmployeeDocumentItem x)=>await Run(async()=>await Service.DeleteDocumentAsync(x.Id,EmployeeId),"Document removed.");
 private void NewFingerprint(){fingerType="right_thumb";templateFormat="ISO 19794-2";templateFile=null;fingerImageFile=null;editor="fingerprint";editorError=null;}private async Task SaveFingerprint(){if(templateFile is null){editorError="Choose the biometric template file.";return;}try{var template=await ReadFile(templateFile,2*1024*1024);var image=fingerImageFile is null?null:await ReadFile(fingerImageFile,3*1024*1024);await Run(async()=>await Service.SaveFingerprintAsync(EmployeeId,fingerType,template,templateFormat,image,actor),"Fingerprint registered.");}catch(Exception e){editorError=e.Message;}}
 private async Task ToggleFingerprint(EmployeeFingerprintItem x)=>await Run(async()=>await Service.SetFingerprintActiveAsync(x.Id,EmployeeId,!x.IsActive,actor),"Fingerprint status updated.");
 private async Task Run(Func<Task> action,string success){saving=true;editorError=null;try{await action();await Reload();CancelEditor();message=success;isError=false;}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.ExclusionViolation){editorError="This effective period overlaps an existing record. Close the previous period or choose different dates.";}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.UniqueViolation){editorError="A record with these details already exists.";}catch(Exception e){editorError=e is InvalidOperationException?e.Message:"Changes could not be saved.";}finally{saving=false;}}
 private static async Task<byte[]> ReadFile(IBrowserFile file,long max){await using var s=file.OpenReadStream(max);using var m=new MemoryStream();await s.CopyToAsync(m);return m.ToArray();}
 private RenderFragment EditorError=>b=>{if(editorError is not null){b.OpenElement(0,"div");b.AddAttribute(1,"class","emp-form-error");b.AddContent(2,editorError);b.CloseElement();}};
 private RenderFragment EditorActions=>b=>{b.OpenElement(0,"div");b.AddAttribute(1,"class","emp-editor-actions");b.OpenElement(2,"button");b.AddAttribute(3,"type","button");b.AddAttribute(4,"onclick",EventCallback.Factory.Create(this,CancelEditor));b.AddContent(5,"Cancel");b.CloseElement();b.OpenElement(6,"button");b.AddAttribute(7,"class","save");b.AddAttribute(8,"disabled",saving);b.AddContent(9,saving?"Saving…":"Save changes");b.CloseElement();b.CloseElement();};
 private RenderFragment HistoryTable(string kind)=>b=>{var seq=0;b.OpenElement(seq++,"div");b.AddAttribute(seq++,"class","emp-history");if(kind=="assignment"){foreach(var x in data!.Assignments){b.OpenElement(seq++,"article");b.AddMarkupContent(seq++,$"<div><b>{x.DesignationName}</b><span>{x.DepartmentName} · {x.BranchName}</span></div><div><b>{x.EffectiveFrom:dd MMM yyyy}</b><span>to {(x.EffectiveTo is null?"Present":x.EffectiveTo.Value.ToString("dd MMM yyyy"))}</span></div>");b.OpenElement(seq++,"button");b.AddAttribute(seq++,"onclick",EventCallback.Factory.Create(this,()=>EditAssignment(x)));b.AddContent(seq++,"Edit");b.CloseElement();b.CloseElement();}}else{foreach(var x in data!.Compensations){b.OpenElement(seq++,"article");b.AddMarkupContent(seq++,$"<div><b>Rs. {x.BaseSalary:N2}</b><span>{Title(x.PayFrequency)} · {System.Net.WebUtility.HtmlEncode(x.Reason??"No reason")}</span></div><div><b>{x.EffectiveFrom:dd MMM yyyy}</b><span>to {(x.EffectiveTo is null?"Present":x.EffectiveTo.Value.ToString("dd MMM yyyy"))}</span></div>");b.OpenElement(seq++,"button");b.AddAttribute(seq++,"onclick",EventCallback.Factory.Create(this,()=>EditCompensation(x)));b.AddContent(seq++,"Edit");b.CloseElement();b.CloseElement();}}b.CloseElement();};
}
