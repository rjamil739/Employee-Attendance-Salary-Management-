@page "/leave"
@attribute [StreamRendering]
@attribute [Authorize(Roles="ADMIN,HR_MANAGER")]
@using System.Security.Claims
@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@using Npgsql
@inject AuthenticationStateProvider AuthState
@inject LeaveService Service
@inject EmployeeService EmployeeService
@inject IJSRuntime JS

<PageTitle>Leave Management</PageTitle>
<div class="emp-shell"><EmployeeSidebar Active="leave" IsAdmin="isAdmin"/><main class="emp-main leave-main">
 <header class="emp-page-head"><div><span>Workforce operations</span><h1>Leave management</h1><p>Policies, balances, employee assignments and approval requests.</p></div><button class="emp-primary" @onclick="OpenNew">+ @AddLabel</button></header>
 @if(message is not null){<div class="emp-notice @(isError?"error":null)">@message</div>}
 <section class="leave-stats"><article class="blue"><i>◫</i><div><b>@types.Count(x=>x.IsActive)</b><span>Active leave types</span></div></article><article class="purple"><i>▤</i><div><b>@policies.Count(x=>x.IsActive)</b><span>Active leave policies</span></div></article><article class="green"><i>✓</i><div><b>@assignments.Count(x=>x.IsActive)</b><span>Active assignments</span></div></article><article class="orange"><i>!</i><div><b>@requests.Count(x=>x.Status=="pending")</b><span>Pending requests</span></div></article></section>
 <nav class="leave-tabs">@foreach(var x in tabs){<button class="@(tab==x.Key?"active":null)" @onclick="()=>SelectTab(x.Key)"><i>@x.Icon</i>@x.Label</button>}</nav>
 <section class="leave-panel">
 @if(loading){<div class="emp-empty">Loading leave workspace…</div>}
 else if(tab=="types"){<header><div><h2>Leave types</h2><p>Configure paid, unpaid, half-day and attachment rules.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search leave type…"/></header><div class="leave-card-grid">@foreach(var x in types.Where(x=>Match(x.Name,x.Code))){<article><div class="leave-card-top"><i>◫</i><em class="@(x.IsActive?"on":"off")">@(x.IsActive?"✓ Active":"○ Inactive")</em></div><h3>@x.Name</h3><small>@x.Code</small><dl><div><dt>Payment</dt><dd>@(x.IsPaid?"Paid":"Unpaid")</dd></div><div><dt>Half day</dt><dd>@(x.AllowHalfDay?"Allowed":"Not allowed")</dd></div><div><dt>Attachment</dt><dd>@(x.RequiresAttachment?"Required":"Optional")</dd></div><div><dt>Maximum</dt><dd>@(x.MaxConsecutiveDays is null?"No limit":$"{x.MaxConsecutiveDays:0.##} days")</dd></div></dl><div class="leave-actions"><button class="view" @onclick="()=>View(x)">View</button><button class="edit" @onclick="()=>EditType(x)">Edit</button><button class="print" @onclick="()=>Print(x)">Print</button><button class="@(x.IsActive?"disable":"enable")" @onclick="()=>ToggleType(x)">@(x.IsActive?"Disable":"Enable")</button></div></article>}</div>}
 else if(tab=="policies"){<header><div><h2>Leave policies</h2><p>Entitlement, accrual and carry-forward configuration.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search policy…"/></header><div class="leave-card-grid">@foreach(var x in policies.Where(x=>Match(x.Name,x.LeaveTypeName))){<article><div class="leave-card-top"><i>⚙</i><em class="@(x.IsActive?"on":"off")">@(x.IsActive?"✓ Active":"○ Inactive")</em></div><h3>@x.Name</h3><small>@x.LeaveTypeName · @Title(x.AccrualFrequency)</small><dl><div><dt>Entitlement</dt><dd>@x.AnnualEntitlement.ToString("0.##") days</dd></div><div><dt>Carry forward</dt><dd>@x.CarryForwardLimit.ToString("0.##") days</dd></div><div><dt>From</dt><dd>@x.EffectiveFrom.ToString("dd MMM yyyy")</dd></div><div><dt>To</dt><dd>@(x.EffectiveTo?.ToString("dd MMM yyyy")??"Ongoing")</dd></div></dl><div class="leave-actions"><button class="view" @onclick="()=>View(x)">View</button><button class="edit" @onclick="()=>EditPolicy(x)">Edit</button><button class="print" @onclick="()=>Print(x)">Print</button><button class="@(x.IsActive?"disable":"enable")" @onclick="()=>TogglePolicy(x)">@(x.IsActive?"Disable":"Enable")</button></div></article>}</div>}
 else if(tab=="assignments"){<header><div><h2>Employee leave policies</h2><p>Assign effective-dated leave policies to employees.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search employee…"/></header><div class="leave-table"><table><thead><tr><th>Employee</th><th>Leave type</th><th>Policy</th><th>Status</th><th>Effective period</th><th>Actions</th></tr></thead><tbody>@foreach(var x in assignments.Where(x=>Match(x.EmployeeName,x.EmployeeNo,x.PolicyName))){<tr><td><b>@x.EmployeeName</b><span>@x.EmployeeNo</span></td><td>@x.LeaveTypeName</td><td>@x.PolicyName</td><td><em class="leave-status @(x.IsActive?"approved":"rejected")">@(x.IsActive?"Active":x.PolicyActive?"Assignment ended":"Policy inactive")</em></td><td>@x.EffectiveFrom.ToString("dd MMM yyyy") – @(x.EffectiveTo?.ToString("dd MMM yyyy")??"Present")</td><td><div class="leave-actions compact"><button class="view" @onclick="()=>View(x)">View</button><button class="edit" @onclick="()=>EditAssignment(x)">Edit</button><button class="print" @onclick="()=>Print(x)">Print</button></div></td></tr>}</tbody></table></div>}
 else if(tab=="balances"){<header><div><h2>Leave balances</h2><p>Current ledger balance for each employee and leave type.</p></div><input @bind="search" @bind:event="oninput" placeholder="Search employee…"/></header><div class="leave-balance-grid">@foreach(var x in balances.Where(x=>Match(x.EmployeeName,x.EmployeeNo,x.LeaveTypeName))){<article class="@(!x.PolicyActive?"inactive":null)"><i>◈</i><div><b>@x.EmployeeName</b><span>@x.EmployeeNo · @x.LeaveTypeName</span><em class="leave-status @(x.PolicyActive?"approved":"rejected")">@(x.PolicyActive?"Active":"Policy inactive")</em></div><strong class="@(x.Balance<0?"negative":null)">@x.Balance.ToString("0.##") <small>days</small></strong><div class="leave-actions compact"><button class="view" @onclick="()=>View(x)">View</button><button class="print" @onclick="()=>Print(x)">Print</button></div></article>}@if(!balances.Any()){<div class="emp-empty">No leave balance entries yet.</div>}</div>}
 else{<header><div><h2>Leave requests</h2><p>Submit, review and decide employee leave requests.</p></div><select @bind="requestFilter"><option value="">All statuses</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="cancelled">Cancelled</option></select></header><div class="leave-request-list">@foreach(var x in requests.Where(x=>string.IsNullOrEmpty(requestFilter)||x.Status==requestFilter)){<article class="@(!x.PolicyActive?"inactive":null)"><i>◫</i><div><b>@x.EmployeeName <small>@x.LeaveTypeName</small></b><span>@x.EmployeeNo · @x.BranchName · @x.StartDate.ToString("dd MMM") – @x.EndDate.ToString("dd MMM yyyy")</span><p>@x.RequestedDays.ToString("0.##") working day(s) · @(string.IsNullOrWhiteSpace(x.Reason)?"No reason":x.Reason)</p>@if(!x.PolicyActive){<em class="leave-policy-warning">Policy inactive</em>}@if(x.AttachmentKey is not null){<a class="leave-attachment" href="@x.AttachmentKey" target="_blank">Open attachment</a>}</div><em class="leave-status @x.Status">@Title(x.Status)</em><div class="leave-actions compact"><button class="view" @onclick="()=>View(x)">View</button><button class="print" @onclick="()=>Print(x)">Print</button></div>@if(x.Status=="pending"){<div class="leave-decisions"><button class="approve" disabled="@(!x.PolicyActive)" title="@(!x.PolicyActive?"Enable policy before approval":null)" @onclick="()=>OpenDecision(x,true)">✓ Approve</button><button class="reject" @onclick="()=>OpenDecision(x,false)">× Reject</button></div>}@if(x.Status is "pending" or "approved"){<button class="leave-cancel" @onclick="()=>CancelRequest(x)">Cancel request</button>}</article>}@if(!requests.Any()){<div class="emp-empty">No leave requests available.</div>}</div>}
 </section>
</main></div>

@if(form is not null){<div class="emp-modal-bg"><section class="leave-dialog"><header><div><span>Leave management</span><h2>@FormTitle</h2></div><button type="button" @onclick="CloseForm">×</button></header><EditForm Model="form" OnValidSubmit="Save" FormName="leave-form"><DataAnnotationsValidator/><div class="leave-form-grid">
 @if(form is LeaveTypeForm t){<label>Code<InputText @bind-Value="t.Code" disabled placeholder="Generated automatically"/></label><label>Name *<InputText @bind-Value="t.Name"/></label><label>Maximum consecutive days<InputNumber @bind-Value="t.MaxConsecutiveDays"/></label><label class="leave-check"><InputCheckbox @bind-Value="t.IsPaid"/><span><b>Paid leave</b><small>Leave is salary paid.</small></span></label><label class="leave-check"><InputCheckbox @bind-Value="t.AllowHalfDay"/><span><b>Allow half day</b></span></label><label class="leave-check"><InputCheckbox @bind-Value="t.RequiresAttachment"/><span><b>Require attachment</b></span></label><label class="leave-check full"><InputCheckbox @bind-Value="t.IsActive"/><span><b>Active leave type</b></span></label>}
 else if(form is LeavePolicyForm p){<label>Leave type *<InputSelect @bind-Value="p.LeaveTypeId"><option value="">Select leave type</option>@foreach(var x in types.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Policy name *<InputText @bind-Value="p.Name"/></label><label>Annual entitlement<InputNumber @bind-Value="p.AnnualEntitlement"/></label><label>Accrual frequency<InputSelect @bind-Value="p.AccrualFrequency"><option value="annual">Annual</option><option value="monthly">Monthly</option><option value="none">None</option></InputSelect></label><label>Carry-forward limit<InputNumber @bind-Value="p.CarryForwardLimit"/></label><label class="leave-check"><InputCheckbox @bind-Value="p.AllowNegativeBalance"/><span><b>Allow negative balance</b></span></label><label>Effective from<InputDate @bind-Value="p.EffectiveFrom"/></label><label>Effective to<InputDate @bind-Value="p.EffectiveTo"/></label>}
 else if(form is EmployeeLeavePolicyForm a){<label>Employee *<InputSelect @bind-Value="a.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Policy *<InputSelect @bind-Value="a.PolicyId"><option value="">Select active policy</option>@foreach(var x in policies.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name · @x.LeaveTypeName</option>}</InputSelect></label><label>Effective from<InputDate @bind-Value="a.EffectiveFrom"/></label><label>Effective to<InputDate @bind-Value="a.EffectiveTo"/></label>@if(a.Id is null){<label class="leave-check full"><InputCheckbox @bind-Value="a.AddOpeningBalance"/><span><b>Add policy entitlement as opening balance</b><small>Creates the employee's initial ledger balance.</small></span></label>}}
 else if(form is LeaveBalanceForm b){<label>Employee *<InputSelect @bind-Value="b.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Leave type *<InputSelect @bind-Value="b.LeaveTypeId"><option value="">Select leave type</option>@foreach(var x in types.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Adjustment days<InputNumber @bind-Value="b.Quantity"/></label><label>Reference *<InputText @bind-Value="b.Reference"/></label>}
 else if(form is LeaveRequestForm r){<label>Employee *<InputSelect @bind-Value="r.EmployeeId"><option value="">Select employee</option>@foreach(var x in employees.Where(x=>x.EmploymentStatus=="active")){<option value="@x.Id">@x.FullName (@x.EmployeeNo)</option>}</InputSelect></label><label>Leave type *<InputSelect @bind-Value="r.LeaveTypeId"><option value="">Select leave type</option>@foreach(var x in types.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</InputSelect></label><label>Start date<InputDate @bind-Value="r.StartDate"/></label><label>End date<InputDate @bind-Value="r.EndDate"/></label><label class="leave-check full"><InputCheckbox @bind-Value="r.IsHalfDay"/><span><b>Half-day leave</b><small>Start and end date must be the same.</small></span></label><label class="full">Supporting attachment (max 10 MB)<InputFile OnChange="e=>attachment=e.File" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx"/></label><label class="full">Reason *<InputTextArea @bind-Value="r.Reason"/></label>}
 </div>@if(formError is not null){<div class="emp-form-error">@formError</div>}<footer><button type="button" @onclick="CloseForm">Cancel</button><button class="save" disabled="@saving">@(saving?"Saving…":"Save")</button></footer></EditForm></section></div>}

@if(viewTitle is not null){<div class="emp-modal-bg"><section class="leave-dialog leave-print-panel"><header><div><span>Leave management</span><h2>@viewTitle</h2></div><button class="leave-no-print" @onclick="CloseView">×</button></header><div class="leave-view-body"><div class="leave-view-banner"><i>◫</i><div><span>Record details</span><b>@viewSubtitle</b></div></div><dl>@foreach(var row in viewRows){<div><dt>@row.Label</dt><dd>@row.Value</dd></div>}</dl><div class="leave-signature"><span>Authorized Signature</span><i></i></div><footer class="leave-no-print"><button @onclick="CloseView">Close</button><button class="save" onclick="window.printAttendancePanel('.leave-print-panel')">Print</button></footer></div></section></div>}

@if(decisionRequest is not null){<div class="emp-modal-bg"><section class="leave-dialog decision"><header><div><span>Leave decision</span><h2>@(approveDecision?"Approve request":"Reject request")</h2></div><button @onclick="CloseDecision">×</button></header><div class="decision-body"><b>@decisionRequest.EmployeeName · @decisionRequest.LeaveTypeName</b><p>@decisionRequest.RequestedDays.ToString("0.##") day(s), @decisionRequest.StartDate.ToString("dd MMM") – @decisionRequest.EndDate.ToString("dd MMM yyyy")</p><label>Decision notes<textarea @bind="decisionNotes" placeholder="Optional remarks"></textarea></label>@if(formError is not null){<div class="emp-form-error">@formError</div>}<footer><button @onclick="CloseDecision">Cancel</button><button class="@(approveDecision?"approve":"reject")" disabled="@saving" @onclick="Decide">@(approveDecision?"Confirm approval":"Confirm rejection")</button></footer></div></section></div>}

@code{
 private readonly (string Key,string Label,string Icon)[] tabs=[("types","Leave types","◫"),("policies","Policies","⚙"),("assignments","Assignments","♙"),("balances","Balances","◈"),("requests","Requests","!")];private IReadOnlyList<LeaveTypeItem> types=[];private IReadOnlyList<LeavePolicyItem> policies=[];private IReadOnlyList<EmployeeLeavePolicyItem> assignments=[];private IReadOnlyList<LeaveBalanceItem> balances=[];private IReadOnlyList<LeaveRequestItem> requests=[];private IReadOnlyList<EmployeeListItem> employees=[];private object? form;private LeaveRequestItem? decisionRequest;private IBrowserFile? attachment;private Guid actor;private bool isAdmin,allAccess,loading=true,saving,isError,approveDecision;private string tab="types",search="",requestFilter="",decisionNotes="";private string? message,formError,viewTitle,viewSubtitle;private List<(string Label,string Value)> viewRows=[];
 private string AddLabel=>tab switch{"types"=>"Add leave type","policies"=>"Add policy","assignments"=>"Assign policy","balances"=>"Adjust balance",_=>"New request"};private string FormTitle=>form switch{LeaveTypeForm x when x.Id is not null=>"Edit leave type",LeaveTypeForm=>"Create leave type",LeavePolicyForm x when x.Id is not null=>"Edit leave policy",LeavePolicyForm=>"Create leave policy",EmployeeLeavePolicyForm x when x.Id is not null=>"Edit employee assignment",EmployeeLeavePolicyForm=>"Assign leave policy",LeaveBalanceForm=>"Adjust leave balance",LeaveRequestForm=>"New leave request",_=>"Leave"};
 protected override async Task OnInitializedAsync(){try{var p=(await AuthState.GetAuthenticationStateAsync()).User;actor=Guid.Parse(p.FindFirstValue(ClaimTypes.NameIdentifier)!);isAdmin=p.IsInRole("ADMIN");allAccess=isAdmin||(bool.TryParse(p.FindFirstValue("all_branch_access"),out var a)&&a);var emp=EmployeeService.GetAllAsync(actor,allAccess);await Task.WhenAll(emp,Reload());employees=await emp;}catch(Exception e){message=e.Message;isError=true;}finally{loading=false;}}
 private async Task Reload(){var t=Service.GetTypesAsync();var p=Service.GetPoliciesAsync();var a=Service.GetAssignmentsAsync();var b=Service.GetBalancesAsync();var r=Service.GetRequestsAsync();await Task.WhenAll(t,p,a,b,r);types=await t;policies=await p;assignments=await a;balances=await b;requests=await r;}
 private void SelectTab(string x){tab=x;search="";form=null;message=null;}private void OpenNew(){attachment=null;form=tab switch{"types"=>new LeaveTypeForm(),"policies"=>new LeavePolicyForm(),"assignments"=>new EmployeeLeavePolicyForm(),"balances"=>new LeaveBalanceForm(),_=>new LeaveRequestForm()};formError=null;}private void CloseForm(){if(!saving)form=null;}
 private void EditType(LeaveTypeItem x)=>form=new LeaveTypeForm{Id=x.Id,Code=x.Code,Name=x.Name,IsPaid=x.IsPaid,RequiresAttachment=x.RequiresAttachment,AllowHalfDay=x.AllowHalfDay,MaxConsecutiveDays=x.MaxConsecutiveDays,IsActive=x.IsActive};private void EditPolicy(LeavePolicyItem x)=>form=new LeavePolicyForm{Id=x.Id,LeaveTypeId=x.LeaveTypeId,Name=x.Name,AnnualEntitlement=x.AnnualEntitlement,AccrualFrequency=x.AccrualFrequency,CarryForwardLimit=x.CarryForwardLimit,AllowNegativeBalance=x.AllowNegativeBalance,EffectiveFrom=x.EffectiveFrom,EffectiveTo=x.EffectiveTo};private void EditAssignment(EmployeeLeavePolicyItem x)=>form=new EmployeeLeavePolicyForm{Id=x.Id,EmployeeId=x.EmployeeId,PolicyId=x.PolicyId,EffectiveFrom=x.EffectiveFrom,EffectiveTo=x.EffectiveTo,AddOpeningBalance=false};
 private void View(LeaveTypeItem x){viewTitle=x.Name;viewSubtitle=x.Code;viewRows=[("Status",x.IsActive?"Active":"Inactive"),("Payment",x.IsPaid?"Paid":"Unpaid"),("Half day",x.AllowHalfDay?"Allowed":"Not allowed"),("Attachment",x.RequiresAttachment?"Required":"Optional"),("Maximum consecutive days",x.MaxConsecutiveDays?.ToString("0.##")??"No limit")];}
 private void View(LeavePolicyItem x){viewTitle=x.Name;viewSubtitle=x.LeaveTypeName;viewRows=[("Status",x.IsActive?"Active":"Inactive"),("Annual entitlement",$"{x.AnnualEntitlement:0.##} days"),("Accrual frequency",Title(x.AccrualFrequency)),("Carry-forward limit",$"{x.CarryForwardLimit:0.##} days"),("Negative balance",x.AllowNegativeBalance?"Allowed":"Not allowed"),("Effective from",x.EffectiveFrom.ToString("dd MMM yyyy")),("Effective to",x.EffectiveTo?.ToString("dd MMM yyyy")??"Ongoing")];}
 private void View(EmployeeLeavePolicyItem x){viewTitle=x.EmployeeName;viewSubtitle=x.EmployeeNo;viewRows=[("Status",x.IsActive?"Active":"Inactive"),("Leave type",x.LeaveTypeName),("Policy",x.PolicyName),("Effective from",x.EffectiveFrom.ToString("dd MMM yyyy")),("Effective to",x.EffectiveTo?.ToString("dd MMM yyyy")??"Ongoing")];}
 private void View(LeaveBalanceItem x){viewTitle="Leave balance";viewSubtitle=x.EmployeeName;viewRows=[("Employee number",x.EmployeeNo),("Leave type",x.LeaveTypeName),("Policy status",x.PolicyActive?"Active":"Inactive"),("Available balance",$"{x.Balance:0.##} days")];}
 private void View(LeaveRequestItem x){viewTitle="Leave request";viewSubtitle=x.EmployeeName;viewRows=[("Employee number",x.EmployeeNo),("Branch",x.BranchName),("Leave type",x.LeaveTypeName),("Policy status",x.PolicyActive?"Active":"Inactive"),("Start date",x.StartDate.ToString("dd MMM yyyy")),("End date",x.EndDate.ToString("dd MMM yyyy")),("Working leave days",x.RequestedDays.ToString("0.##")),("Attachment",x.AttachmentKey is null?"Not attached":"Attached"),("Request status",Title(x.Status)),("Reason",x.Reason??"—"),("Decision notes",x.DecisionNotes??"—")];}
 private async Task Print(object x){switch(x){case LeaveTypeItem a:View(a);break;case LeavePolicyItem a:View(a);break;case EmployeeLeavePolicyItem a:View(a);break;case LeaveBalanceItem a:View(a);break;case LeaveRequestItem a:View(a);break;}await InvokeAsync(StateHasChanged);await Task.Delay(80);await JS.InvokeVoidAsync("printAttendancePanel",".leave-print-panel");}private void CloseView()=>viewTitle=null;
 private async Task ToggleType(LeaveTypeItem x)=>await Toggle(async()=>await Service.SetTypeActiveAsync(x.Id,!x.IsActive,actor),x.IsActive);private async Task TogglePolicy(LeavePolicyItem x)=>await Toggle(async()=>await Service.SetPolicyActiveAsync(x.Id,!x.IsActive,actor),x.IsActive);private async Task Toggle(Func<Task> action,bool wasActive){try{await action();await Reload();message=$"Record {(wasActive?"disabled":"enabled")} successfully.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}
 private async Task Save(){saving=true;formError=null;try{switch(form){case LeaveTypeForm x:await Service.SaveTypeAsync(x,actor);break;case LeavePolicyForm x:await Service.SavePolicyAsync(x,actor);break;case EmployeeLeavePolicyForm x:await Service.SaveAssignmentAsync(x,actor);break;case LeaveBalanceForm x:await Service.AddBalanceAsync(x,actor);break;case LeaveRequestForm x:byte[]? bytes=null;if(attachment is not null){await using var input=attachment.OpenReadStream(10*1024*1024);await using var ms=new MemoryStream();await input.CopyToAsync(ms);bytes=ms.ToArray();}await Service.SaveRequestAdvancedAsync(x,attachment?.Name,attachment?.ContentType,bytes,actor);break;}await Reload();form=null;message="Leave record saved successfully.";isError=false;}catch(PostgresException e)when(e.SqlState==PostgresErrorCodes.UniqueViolation){formError="A duplicate leave record already exists.";}catch(Exception e){formError=e.Message;}finally{saving=false;}}
 private void OpenDecision(LeaveRequestItem x,bool approve){decisionRequest=x;approveDecision=approve;decisionNotes="";formError=null;}private void CloseDecision(){if(!saving)decisionRequest=null;}private async Task Decide(){saving=true;formError=null;try{await Service.DecideAsync(decisionRequest!,approveDecision?"approved":"rejected",decisionNotes,actor);await Reload();decisionRequest=null;message=$"Leave request {(approveDecision?"approved":"rejected")}.";isError=false;}catch(Exception e){formError=e.Message;}finally{saving=false;}}
 private async Task CancelRequest(LeaveRequestItem x){try{await Service.CancelRequestAsync(x,"Cancelled by administrator",actor);await Reload();message="Leave request cancelled and balance restored where applicable.";isError=false;}catch(Exception e){message=e.Message;isError=true;}}
 private bool Match(params string[] values)=>string.IsNullOrWhiteSpace(search)||values.Any(x=>x.Contains(search,StringComparison.OrdinalIgnoreCase));private static string Title(string x)=>System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(x.Replace('_',' '));
}
