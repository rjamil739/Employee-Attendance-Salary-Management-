@using Employee_Attendance_Salary_Management.Models
@using Employee_Attendance_Salary_Management.Services
@inject CompanyProfileService CompanyService

<style>.sm-sidebar nav a{font-weight:750}</style>

<aside class="sm-sidebar">
    <a class="sm-brand" href="/dashboard/admin">
        @if (company?.LogoDataUrl is not null) { <img src="@company.LogoDataUrl" alt="Company logo" /> }
        else { <span>HR</span> }
        <div><strong>@(company?.CompanyName ?? "HR Portal")</strong><small>Administration</small></div>
    </a>
    <nav>
        <a href="/dashboard/admin">⌂ <span>Overview</span></a>
        <a href="/employees">♙ <span>Employees</span></a>
        <b>Settings</b>
        <a class="@(Active=="users"?"active":null)" href="/dashboard/admin/settings/users">♙ <span>Users</span></a>
        <a class="@(Active=="branches"?"active":null)" href="/dashboard/admin/settings/branches">▦ <span>Branches</span></a>
        <a class="@(Active=="organization"?"active":null)" href="/dashboard/admin/settings/organization">⌘ <span>Organization</span></a>
        <a class="@(Active=="contractors"?"active":null)" href="/dashboard/admin/settings/contractors">◇ <span>Contractors</span></a>
        <a class="@(Active=="access"?"active":null)" href="/dashboard/admin/settings/access">⚿ <span>Access control</span></a>
    </nav>
    <form method="post" action="/auth/logout"><AntiforgeryToken /><button type="submit">↪ <span>Sign out</span></button></form>
</aside>

@code {
    [Parameter] public string Active { get; set; } = string.Empty;
    private CompanyProfile? company;
    protected override async Task OnInitializedAsync() => company = await CompanyService.GetAsync();
}
