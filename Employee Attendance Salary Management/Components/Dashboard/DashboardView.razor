@using Employee_Attendance_Salary_Management.Models

<div class="dashboard-shell @(IsAdmin ? "admin-dashboard" : "hr-dashboard")">
    <EmployeeSidebar Active="overview" IsAdmin="IsAdmin"/>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div>
                <span class="page-kicker">@(IsAdmin ? "Company administration" : "HR operations")</span>
                <h1>Good @Greeting, @FirstName</h1>
                <p>@Summary.BranchLabel · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            </div>
            <div class="user-badge">
                <span>@Initials</span>
                <div><strong>@DisplayName</strong><small>@(IsAdmin ? "Administrator" : "HR Manager")</small></div>
            </div>
        </header>

        <section class="summary-grid" aria-label="Key statistics">
            <article class="summary-card blue">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M4 20V7l8-3v16M4 20h16M12 9h8v11" /></svg></span>
                <div><small>Active branches</small><strong>@Summary.Branches</strong><span>@Summary.BranchLabel</span></div>
            </article>
            <article class="summary-card violet">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8M17 11h5" /></svg></span>
                <div><small>Active employees</small><strong>@Summary.Employees</strong><span>Current assignments</span></div>
            </article>
            <article class="summary-card green">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg></span>
                <div><small>Present today</small><strong>@Summary.PresentToday</strong><span>Present and late</span></div>
            </article>
            <article class="summary-card orange">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M12 8v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg></span>
                <div><small>Pending requests</small><strong>@(Summary.PendingLeaves + Summary.PendingAttendanceRequests)</strong><span>Leave and attendance</span></div>
            </article>
        </section>

        <div class="content-heading">
            <div><h2>System overview</h2><p>Live totals from your HR and payroll database</p></div>
            <span class="live-indicator"><i></i> Live data</span>
        </div>

        <section class="module-grid">
            <a class="module-card" id="attendance" href="/attendance">
                <span class="module-icon teal"><svg viewBox="0 0 24 24"><path d="M8 3v3M16 3v3M4 9h16M5 5h14v16H5z" /></svg></span>
                <div><h3>Attendance</h3><p>Shifts, schedules and daily records</p></div>
                <strong>@Summary.PendingAttendanceRequests <small>pending</small></strong>
                <span class="module-meta">@Summary.PendingAttendanceRequests pending requests</span>
            </a>
            <a class="module-card" id="leave" href="/leave">
                <span class="module-icon purple"><svg viewBox="0 0 24 24"><path d="M6 3v3M18 3v3M4 8h16v13H4zM8 12h8M8 16h5" /></svg></span>
                <div><h3>Leave management</h3><p>Requests, policies and balances</p></div>
                <strong>@Summary.PendingLeaves <small>pending</small></strong>
                <span class="module-meta">Awaiting decision</span>
            </a>
            <a class="module-card" id="payroll" href="/payroll">
                <span class="module-icon blue"><svg viewBox="0 0 24 24"><path d="M4 7h16v12H4zM4 11h16M8 15h3" /></svg></span>
                <div><h3>Payroll</h3><p>Periods, calculations and results</p></div>
                <strong>@Summary.ActivePayrollRuns <small>active</small></strong>
                <span class="module-meta">Open payroll workflows</span>
            </a>
            <article class="module-card" id="finance">
                <span class="module-icon green"><svg viewBox="0 0 24 24"><path d="M3 21h18M5 18h14M6 10h12M4 7l8-4 8 4M7 10v8M12 10v8M17 10v8" /></svg></span>
                <div><h3>Salary payments</h3><p>Paid during the current month</p></div>
                <strong>@Summary.PaidThisMonth.ToString("N0") <small>amount</small></strong>
                <span class="module-meta">Confirmed paid payments</span>
            </article>
            <article class="module-card">
                <span class="module-icon orange"><svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6" /></svg></span>
                <div><h3>Employee loans</h3><p>Approved, active and paused loans</p></div>
                <strong>@Summary.ActiveLoans <small>loans</small></strong>
                <span class="module-meta">Under recovery</span>
            </article>
            <article class="module-card">
                <span class="module-icon rose"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></span>
                <div><h3>Approvals</h3><p>Workflow items requiring action</p></div>
                <strong>@Summary.PendingApprovals <small>pending</small></strong>
                <span class="module-meta">Across available branches</span>
            </article>
            @if (IsAdmin)
            {
                <article class="module-card" id="users">
                    <span class="module-icon slate"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M8.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M17 8h6M20 5v6" /></svg></span>
                    <div><h3>User access</h3><p>Active application accounts</p></div>
                    <strong>@Summary.ActiveUsers <small>users</small></strong>
                    <a class="module-meta manage-users-link" href="/dashboard/admin/settings/users">Manage users →</a>
                </article>
            }
        </section>
    </main>
</div>

@code {
    [Parameter, EditorRequired] public DashboardSummary Summary { get; set; } = new();
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;
    [Parameter] public CompanyProfile? Company { get; set; }
    [Parameter] public bool IsAdmin { get; set; }

    private string FirstName => DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
    private string Initials => string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private string Greeting => DateTime.Now.Hour switch { < 12 => "morning", < 17 => "afternoon", _ => "evening" };
}
